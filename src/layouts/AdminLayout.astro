---
interface Props {
  titulo: string;
  nome?: string;
  perfil?: string;
  ativo?:
    | "inicio"
    | "noticias"
    | "cursos"
    | "eventos"
    | "utilizadores"
    | "paginas"
    | "documentacao";
}

const {
  titulo,
  nome = "Coordenador",
  perfil = "Coordenador",
  ativo,
} = Astro.props;

const perfilAdmin = Astro.locals.perfilAdmin;

const eSuperAdmin =
  perfilAdmin?.ativo === true &&
  perfilAdmin.perfil === "super_admin";

// As permissões são calculadas no middleware.
// Não são feitas consultas ao Supabase neste layout.
const permissoesMenu = Astro.locals.permissoesMenu ?? {};

function temAcesso(recurso: string): boolean {
  return eSuperAdmin || permissoesMenu[recurso] === true;
}

const podeVerNoticias = temAcesso("noticias");
const podeVerCursos = temAcesso("cursos");
const podeVerEventos = temAcesso("eventos");
const podeVerPaginas = temAcesso("paginas");
const podeVerDocumentacao = temAcesso("documentacao");

const caminho = Astro.url.pathname;
const caminhoNormalizado = caminho.replace(/\/$/, "") || "/";

// Páginas disponíveis no submenu.
// Confirmar os caminhos com os nomes reais dos ficheiros.
const paginasWebsite = [
  {
    nome: "Página Inicial",
    href: "/admin/paginas/inicio",
  },
  {
    nome: "Sobre Nós",
    href: "/admin/paginas/sobre-nos",
  },
  {
    nome: "Contactos",
    href: "/admin/paginas/contactos",
  },
  {
    nome: "Qualidade EQAVET",
    href: "/admin/paginas/qualidade",
  },
];

const paginaWebsiteAtiva = paginasWebsite.find(
  (pagina) => pagina.href === caminhoNormalizado
)?.href;

const secaoAtiva =
  ativo ??
  (caminho.startsWith("/admin/utilizadores")
    ? "utilizadores"
    : caminho.startsWith("/admin/paginas")
      ? "paginas"
      : caminho.startsWith("/admin/documentacao")
        ? "documentacao"
        : caminho.startsWith("/admin/noticias")
          ? "noticias"
          : caminho.startsWith("/admin/cursos")
            ? "cursos"
            : caminho.startsWith("/admin/eventos")
              ? "eventos"
              : "inicio");
---

<html lang="pt">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{titulo} | EPF</title>
  </head>

  <body>
    <div class="admin">
      <!-- NAVEGAÇÃO LATERAL -->
      <aside class="barra-lateral" id="barra-lateral">
        <div class="lateral-cabecalho">
          <a class="marca" href="/admin/">
            <img
              src="/logo.png"
              alt="Logótipo da Escola Profissional do Fundão"
              class="marca-logo"
            />

            <span class="marca-texto">
              <strong>Escola Profissional</strong>
              <small>do Fundão</small>

              <span class="marca-subtitulo">
                Administração
              </span>
            </span>
          </a>

          <!-- Botão do menu para tablet e telemóvel -->
          <button
            class="botao-menu"
            id="botao-menu"
            type="button"
            aria-label="Abrir menu de navegação"
            aria-controls="menu-conteudo"
            aria-expanded="false"
          >
            <span class="botao-menu-linhas" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
        </div>

        <!-- Área de navegação recolhível -->
        <div class="menu-conteudo" id="menu-conteudo">
          <div class="menu-titulo">
            MENU PRINCIPAL
          </div>

          <nav
            class="menu-navegacao"
            aria-label="Navegação administrativa"
          >
            <!-- VISÃO GERAL -->
            <a
              href="/admin/"
              class:list={[
                "menu-link",
                secaoAtiva === "inicio" && "ativo",
              ]}
              aria-current={
                secaoAtiva === "inicio"
                  ? "page"
                  : undefined
              }
            >
              <span class="menu-icone" aria-hidden="true">▦</span>
              <span>Visão geral</span>
            </a>

            <!-- NOTÍCIAS -->
            {
              podeVerNoticias && (
                <a
                  href="/admin/noticias/"
                  class:list={[
                    "menu-link",
                    secaoAtiva === "noticias" && "ativo",
                  ]}
                  aria-current={
                    secaoAtiva === "noticias"
                      ? "page"
                      : undefined
                  }
                >
                  <span class="menu-icone" aria-hidden="true">
                    ▤
                  </span>
                  <span>Notícias</span>
                </a>
              )
            }

            <!-- CURSOS -->
            {
              podeVerCursos && (
                <a
                  href="/admin/cursos/"
                  class:list={[
                    "menu-link",
                    secaoAtiva === "cursos" && "ativo",
                  ]}
                  aria-current={
                    secaoAtiva === "cursos"
                      ? "page"
                      : undefined
                  }
                >
                  <span class="menu-icone" aria-hidden="true">
                    ▧
                  </span>
                  <span>Cursos</span>
                </a>
              )
            }

            <!-- EVENTOS -->
            {
              podeVerEventos && (
                <a
                  href="/admin/eventos/"
                  class:list={[
                    "menu-link",
                    secaoAtiva === "eventos" && "ativo",
                  ]}
                  aria-current={
                    secaoAtiva === "eventos"
                      ? "page"
                      : undefined
                  }
                >
                  <span class="menu-icone" aria-hidden="true">
                    ▦
                  </span>
                  <span>Eventos</span>
                </a>
              )
            }

            <!-- PÁGINAS DO WEBSITE -->
            {
              podeVerPaginas && (
                <div class="grupo-paginas">
                  <details
                    class="menu-grupo"
                    open={secaoAtiva === "paginas"}
                  >
                    <summary
                      class:list={[
                        "menu-link",
                        "menu-grupo-titulo",
                        secaoAtiva === "paginas" && "ativo",
                      ]}
                      aria-label="Expandir ou recolher Páginas do Website"
                    >
                      <span
                        class="menu-icone"
                        aria-hidden="true"
                      >
                        ▤
                      </span>

                      <span>Páginas do Website</span>

                      <span
                        class="menu-seta"
                        aria-hidden="true"
                      >
                        ⌄
                      </span>
                    </summary>

                    <div class="menu-subpaginas">
                      {
                        paginasWebsite.map((pagina) => (
                          <a
                            href={pagina.href}
                            class:list={[
                              "menu-sublink",
                              paginaWebsiteAtiva === pagina.href &&
                                "ativo",
                            ]}
                            aria-current={
                              paginaWebsiteAtiva === pagina.href
                                ? "page"
                                : undefined
                            }
                          >
                            <span
                              class="menu-subponto"
                              aria-hidden="true"
                            />
                            <span>{pagina.nome}</span>
                          </a>
                        ))
                      }
                    </div>
                  </details>
                </div>
              )
            }

            <!-- DOCUMENTAÇÃO -->
            {
              podeVerDocumentacao && (
                <a
                  href="/admin/documentacao/"
                  class:list={[
                    "menu-link",
                    secaoAtiva === "documentacao" && "ativo",
                  ]}
                  aria-current={
                    secaoAtiva === "documentacao"
                      ? "page"
                      : undefined
                  }
                >
                  <span class="menu-icone" aria-hidden="true">
                    ▣
                  </span>
                  <span>Documentação</span>
                </a>
              )
            }

            <!-- GESTÃO DO SISTEMA -->
            {
              eSuperAdmin && (
                <>
                  <div
                    class="menu-separador"
                    aria-hidden="true"
                  />

                  <div class="menu-titulo menu-titulo-secundario">
                    GESTÃO DO SISTEMA
                  </div>

                  <a
                    href="/admin/utilizadores/"
                    class:list={[
                      "menu-link",
                      secaoAtiva === "utilizadores" && "ativo",
                    ]}
                    aria-current={
                      secaoAtiva === "utilizadores"
                        ? "page"
                        : undefined
                    }
                  >
                    <span
                      class="menu-icone"
                      aria-hidden="true"
                    >
                      ♙
                    </span>
                    <span>Utilizadores</span>
                  </a>
                </>
              )
            }
          </nav>

          <!-- RODAPÉ DO MENU -->
          <div class="lateral-rodape">
            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="ver-site"
            >
              ↗ Ver site público
            </a>

            <form action="/admin/sair" method="POST">
              <button type="submit" class="botao-sair">
                Terminar sessão
              </button>
            </form>
          </div>
        </div>
      </aside>

      <!-- ÁREA PRINCIPAL -->
      <div class="principal">
        <header class="topo">
          <div class="topo-identidade">
            <span class="topo-etiqueta">
              ÁREA RESERVADA
            </span>

            <strong>Administração EPF</strong>
          </div>

          <div class="utilizador">
            <div class="avatar" aria-hidden="true">
              {nome.charAt(0).toUpperCase()}
            </div>

            <div class="utilizador-texto">
              <strong>{nome}</strong>
              <small>{perfil}</small>
            </div>
          </div>
        </header>

        <main class="conteudo" id="conteudo-principal">
          <slot />
        </main>
      </div>
    </div>

    <!-- CONTROLO DO MENU EM ECRÃS PEQUENOS -->
    <script>
      const botaoMenu = document.getElementById(
        "botao-menu"
      ) as HTMLButtonElement | null;

      const menuConteudo = document.getElementById(
        "menu-conteudo"
      );

      const barraLateral = document.getElementById(
        "barra-lateral"
      );

      const mediaMenu = window.matchMedia(
        "(max-width: 900px)"
      );

      function atualizarEstadoMenu(aberto: boolean) {
        if (!botaoMenu || !menuConteudo || !barraLateral) {
          return;
        }

        const menuAberto = mediaMenu.matches && aberto;

        barraLateral.classList.toggle(
          "menu-aberto",
          menuAberto
        );

        botaoMenu.setAttribute(
          "aria-expanded",
          String(menuAberto)
        );

        botaoMenu.setAttribute(
          "aria-label",
          menuAberto
            ? "Fechar menu de navegação"
            : "Abrir menu de navegação"
        );

        if (mediaMenu.matches) {
          menuConteudo.setAttribute(
            "aria-hidden",
            String(!menuAberto)
          );

          if ("inert" in menuConteudo) {
            menuConteudo.inert = !menuAberto;
          }
        } else {
          menuConteudo.removeAttribute("aria-hidden");

          if ("inert" in menuConteudo) {
            menuConteudo.inert = false;
          }
        }
      }

      if (botaoMenu && menuConteudo && barraLateral) {
        atualizarEstadoMenu(false);

        botaoMenu.addEventListener("click", () => {
          const estaAberto =
            barraLateral.classList.contains("menu-aberto");

          atualizarEstadoMenu(!estaAberto);
        });

        // Fechar o menu com Escape.
        document.addEventListener("keydown", (evento) => {
          if (
            evento.key === "Escape" &&
            barraLateral.classList.contains("menu-aberto")
          ) {
            atualizarEstadoMenu(false);
            botaoMenu.focus();
          }
        });

        // Reajustar o menu quando muda a largura do ecrã.
        mediaMenu.addEventListener("change", () => {
          atualizarEstadoMenu(false);
        });

        // Fechar o menu móvel depois de escolher uma página.
        menuConteudo
          .querySelectorAll<HTMLAnchorElement>(
            ".menu-link, .menu-sublink"
          )
          .forEach((ligacao) => {
            ligacao.addEventListener("click", () => {
              if (
                mediaMenu.matches &&
                ligacao.tagName === "A"
              ) {
                atualizarEstadoMenu(false);
              }
            });
          });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ==================================================
     1. VARIÁVEIS E BASE VISUAL
     ================================================== */

  :root {
    --admin-verde: #267a4b;
    --admin-verde-escuro: #20663f;
    --admin-verde-claro: #e6f5ec;

    --admin-fundo: #f4f7fa;
    --admin-superficie: #ffffff;

    --admin-texto: #203247;
    --admin-texto-secundario: #75869a;
    --admin-borda: #e4eaf0;

    --admin-raio: 0.75rem;

    --admin-lateral-largura: clamp(
      14rem,
      19vw,
      16.5rem
    );

    --admin-espacamento: clamp(
      1rem,
      2.6vw,
      2.375rem
    );
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 0;
  }

  body {
    margin: 0;
    min-width: 0;

    background: var(--admin-fundo);
    color: var(--admin-texto);

    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
  }

  button,
  input,
  select,
  textarea {
    font-family: inherit;
  }

  a {
    text-decoration: none;
  }

  button {
    -webkit-tap-highlight-color: transparent;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #a7d9bd;
    outline-offset: 3px;
  }

  /* ==================================================
     2. ESTRUTURA PRINCIPAL
     ================================================== */

  .admin {
    display: grid;

    grid-template-columns:
      var(--admin-lateral-largura)
      minmax(0, 1fr);

    min-height: 100vh;
    min-height: 100dvh;
  }

  .principal {
    min-width: 0;

    display: flex;
    flex-direction: column;
  }

  /* ==================================================
     3. BARRA LATERAL
     ================================================== */

  .barra-lateral {
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 100vh;
    min-height: 100dvh;

    padding: 1.5rem 1rem;

    background: var(--admin-verde);
    color: #ffffff;
  }

  .lateral-cabecalho {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    min-width: 0;
    padding: 0.25rem 0.5rem 1.5rem;

    color: #ffffff;
  }

  .marca-logo {
    width: 3.625rem;
    height: 3.625rem;

    flex: 0 0 auto;
    object-fit: contain;
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .marca strong {
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .marca small {
    margin-top: 0.125rem;

    color: rgba(255, 255, 255, 0.9);
    font-size: 0.75rem;
  }

  .marca-subtitulo {
    margin-top: 0.3125rem;

    color: rgba(255, 255, 255, 0.75);

    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu-conteudo {
    display: flex;
    flex-direction: column;

    flex: 1;
    min-height: 0;
  }

  .menu-titulo {
    padding: 0.75rem 0.875rem;

    color: rgba(255, 255, 255, 0.7);

    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  /* ==================================================
     4. NAVEGAÇÃO PRINCIPAL
     ================================================== */

  .menu-navegacao {
    display: grid;
    align-content: start;
    gap: 0.25rem;
  }

  .menu-link {
    position: relative;

    display: flex;
    align-items: center;
    gap: 0.75rem;

    min-width: 0;
    min-height: 2.75rem;

    padding: 0.75rem 0.875rem;

    border: 1px solid transparent;
    border-radius: 0.625rem;

    color: rgba(255, 255, 255, 0.88);

    font-size: 0.875rem;
    font-weight: 550;
    line-height: 1.4;

    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .menu-link > span:last-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .menu-icone {
    display: inline-grid;
    place-items: center;

    width: 1.375rem;
    flex: 0 0 1.375rem;

    font-size: 1.125rem;
    line-height: 1;
    text-align: center;
  }

  .menu-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .menu-link.ativo,
  .menu-link[aria-current="page"] {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.12);

    color: #ffffff;
    font-weight: 700;
  }

  .menu-link.ativo::before,
  .menu-link[aria-current="page"]::before {
    content: "";

    position: absolute;
    top: 20%;
    bottom: 20%;
    left: 0;

    width: 0.1875rem;

    border-radius: 0 0.25rem 0.25rem 0;
    background: #ffffff;
  }

  .menu-link.ativo:hover,
  .menu-link[aria-current="page"]:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  /* ==================================================
     5. SUBMENU DAS PÁGINAS DO WEBSITE
     ================================================== */

  .grupo-paginas,
  .menu-grupo {
    min-width: 0;
  }

  .menu-grupo-titulo {
    cursor: pointer;
    list-style: none;
  }

  .menu-grupo-titulo::-webkit-details-marker {
    display: none;
  }

  .menu-grupo-titulo::marker {
    content: "";
  }

  .menu-seta {
    margin-left: auto;

    font-size: 1.125rem;
    line-height: 1;

    transition: transform 160ms ease;
  }

  .menu-grupo[open] .menu-seta {
    transform: rotate(180deg);
  }

  .menu-subpaginas {
    display: grid;
    gap: 0.1875rem;

    margin: 0.25rem 0 0.5rem 1.25rem;
    padding-left: 0.625rem;

    border-left: 1px solid rgba(255, 255, 255, 0.25);
  }

  .menu-sublink {
    display: flex;
    align-items: center;
    gap: 0.625rem;

    min-width: 0;
    min-height: 2.5rem;

    padding: 0.625rem 0.75rem;

    border: 1px solid transparent;
    border-radius: 0.5rem;

    color: rgba(255, 255, 255, 0.85);

    font-size: 0.8125rem;
    line-height: 1.4;

    overflow-wrap: anywhere;

    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .menu-subponto {
    width: 0.375rem;
    height: 0.375rem;

    flex: 0 0 auto;

    border-radius: 50%;
    background: currentColor;
    opacity: 0.65;
  }

  .menu-sublink:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .menu-sublink.ativo,
  .menu-sublink[aria-current="page"] {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.12);

    color: #ffffff;
    font-weight: 700;
  }

  .menu-grupo-titulo:focus-visible,
  .menu-sublink:focus-visible {
    outline: 3px solid #a7d9bd;
    outline-offset: 2px;
  }

  /* ==================================================
     6. SEPARADORES E RODAPÉ
     ================================================== */

  .menu-separador {
    height: 1px;

    margin: 1rem 0.75rem 0.375rem;

    background: rgba(255, 255, 255, 0.2);
  }

  .menu-titulo-secundario {
    padding-top: 0.75rem;
  }

  .lateral-rodape {
    display: grid;
    gap: 1rem;

    margin-top: auto;
    padding: 1.5rem 0.625rem 0;
  }

  .ver-site {
    display: inline-flex;
    align-items: center;

    width: fit-content;

    color: #ffffff;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .ver-site:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .lateral-rodape form {
    margin: 0;
  }

  .botao-sair {
    width: 100%;
    min-height: 2.75rem;

    padding: 0.75rem;

    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 0.625rem;

    background: transparent;
    color: #ffffff;

    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;

    cursor: pointer;

    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .botao-sair:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.7);
  }

  /* ==================================================
     7. BOTÃO DO MENU MÓVEL
     ================================================== */

  .botao-menu {
    display: none;
    align-items: center;
    justify-content: center;

    width: 2.75rem;
    height: 2.75rem;

    flex: 0 0 auto;
    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 0.625rem;

    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;

    cursor: pointer;
  }

  .botao-menu:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .botao-menu-linhas {
    display: grid;
    gap: 0.3rem;
  }

  .botao-menu-linhas span {
    display: block;

    width: 1.2rem;
    height: 2px;

    border-radius: 2px;
    background: currentColor;

    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .menu-aberto .botao-menu-linhas span:first-child {
    transform: translateY(0.425rem) rotate(45deg);
  }

  .menu-aberto .botao-menu-linhas span:nth-child(2) {
    opacity: 0;
  }

  .menu-aberto .botao-menu-linhas span:last-child {
    transform: translateY(-0.425rem) rotate(-45deg);
  }

  /* ==================================================
     8. CABEÇALHO SUPERIOR
     ================================================== */

  .topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    min-height: 5.125rem;

    padding:
      1rem
      var(--admin-espacamento);

    background: var(--admin-superficie);

    border-bottom: 1px solid var(--admin-borda);
  }

  .topo-identidade {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .topo-etiqueta {
    color: #8291a2;

    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .topo-identidade strong {
    color: #203247;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

