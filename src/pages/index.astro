
---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Apoios from '../components/Apoios.astro';
import edificio from '../assets/escola/edificio.webp';
import fundoErasmus from '../assets/erasmus-bandeiras.webp';
import logotiposErasmus from '../assets/erasmus-logotipos-claro.webp';
import alunos from '../assets/escola/alunos-entrada.webp';
import Icone from '../components/Icone.astro';
import CartaoCurso from '../components/CartaoCurso.astro';
import CartaoNoticia from '../components/CartaoNoticia.astro';
import ChamadaInscricoes from '../components/ChamadaInscricoes.astro';
import { site, erasmus } from '../data/site';
import { criarSupabaseServer } from '../lib/supabase/server';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const supabase = criarSupabaseServer(Astro);

// CURSOS — todos os publicados no Supabase
const { data: cursosSupabase, error: erroCursos } = await supabase
  .from('cursos')
  .select('id, slug, titulo, tipo, area, nivel, duracao, icone, cartazes, ordem')
  .eq('publicado', true)
  .order('ordem', { ascending: true });

if (erroCursos) {
  console.error(
    'Erro ao carregar cursos da página inicial:',
    erroCursos.message
  );
}

const cursos = cursosSupabase ?? [];

const profissionais = cursos.filter(
  (c) => c.tipo === 'profissional'
);

const cef = cursos.filter(
  (c) => c.tipo === 'cef'
);

// NOTÍCIAS — Markdown + publicadas no Supabase
const noticiasMarkdown = await getCollection('noticias');

const { data: noticiasSupabase, error: erroNoticias } = await supabase
  .from('noticias')
  .select('id, titulo, resumo, imagem_url, criado_em, publicada')
  .eq('publicada', true)
  .order('criado_em', { ascending: false });

if (erroNoticias) {
  console.error(
    'Erro ao carregar notícias da página inicial:',
    erroNoticias.message
  );
}

const noticias = [
  ...noticiasMarkdown,
  ...(noticiasSupabase ?? []),
]
  .sort((a, b) => {
    const dataA = 'criado_em' in a
      ? new Date(a.criado_em).getTime()
      : new Date(a.data.data).getTime();

    const dataB = 'criado_em' in b
      ? new Date(b.criado_em).getTime()
      : new Date(b.data.data).getTime();

    return dataB - dataA;
  })
  .slice(0, 3);

// EVENTOS — próximos eventos publicados no Supabase
const agora = new Date().toISOString();

const { data: eventosSupabase, error: erroEventos } = await supabase
  .from('eventos')
  .select('id, titulo, descricao, data_inicio, data_fim, local, imagem_url')
  .eq('publicado', true)
  .gte('data_inicio', agora)
  .order('data_inicio', { ascending: true })
  .limit(3);

if (erroEventos) {
  console.error(
    'Erro ao carregar eventos da página inicial:',
    erroEventos.message
  );
}

const eventos = eventosSupabase ?? [];

const formatarDataEvento = (valor: string) =>
  new Intl.DateTimeFormat('pt-PT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Lisbon',
  }).format(new Date(valor));

const destaques = [
  { valor: String(site.fundacao), rotulo: 'Ano de fundação' },
  { valor: String(profissionais.length), rotulo: 'Cursos profissionais' },
  { valor: erasmus[0].valor, rotulo: 'Mobilidades Erasmus+' },
  { valor: erasmus[3].valor, rotulo: 'Países de destino' },
];

const atalhos = [
  { nome: 'Cursos Profissionais', nota: 'Nível 4 · 12.º ano', url: '/oferta-formativa/#profissionais', icone: 'capelo' },
  { nome: 'Cursos CEF', nota: 'Nível 2 · 9.º ano', url: '/oferta-formativa/#cef', icone: 'chave' },
  { nome: 'Erasmus+', nota: 'Estágios na Europa', url: '/erasmus/', icone: 'globo' },
  { nome: 'Qualidade EQAVET', nota: 'Selo e relatórios', url: '/qualidade/', icone: 'selo' },
  { nome: 'Documentos', nota: 'Regulamentos e calendário', url: '/escola/documentos/', icone: 'documento' },
  { nome: 'Recrutamento', nota: 'Emprego e estágios', url: '/comunidade/#recrutamento', icone: 'pasta' },
];

const pilares = [
  {
    titulo: 'Aprender uma profissão',
    texto:
      'Além das disciplinas científicas e socioculturais, os cursos têm uma forte componente técnica, com estágios e práticas em contexto de trabalho. Quem sai da EPF sai com uma profissão.',
    icone: 'pasta',
  },
  {
    titulo: 'Prosseguir estudos',
    texto:
      'A frequência de uma escola profissional é compatível com a entrada no ensino superior. Os nossos alunos já estão rotinados com métodos de trabalho que encontrarão mais tarde.',
    icone: 'capelo',
  },
  {
    titulo: 'Ligação ao território',
    texto:
      'Mantemos protocolos de colaboração com o poder local, a sociedade civil, associações e empresas, e uma rede europeia de parceiros para estágios internacionais.',
    icone: 'pessoas',
  },
];
---

<Base>
  <section class="heroi">
    <Image
      src={edificio}
      alt="Edifício da Escola Profissional do Fundão, com a escadaria da entrada principal"
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="heroi__fundo"
    />

    <div class="contentor heroi__dentro">
      <div class="heroi__texto">
        <span class="sobretitulo">{site.assinatura}</span>

        <h1>
          Formação profissional na Cova da Beira
          <em>desde {site.fundacao}.</em>
        </h1>

        <p>
          Cursos com dupla certificação, ensino gratuito,
          estágios em empresas e mobilidade europeia.
        </p>

        <div class="heroi__acoes">
          <a href="/inscricoes/" class="botao botao--primario">
            Inscreve-te
            <Icone nome="seta" tamanho={18} />
          </a>

          <a
            href="/oferta-formativa/"
            class="botao botao--contorno-claro"
          >
            Ver oferta formativa
          </a>
        </div>
      </div>

      <dl class="heroi__numeros">
        {
          destaques.map((d) => (
            <div>
              <dt>{d.valor}</dt>
              <dd>{d.rotulo}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="atalhos" aria-label="Acesso rápido">
    <div class="contentor">
      <ul>
        {
          atalhos.map((a) => (
            <li>
              <a href={a.url}>
                <Icone nome={a.icone} />

                <span>
                  <strong>{a.nome}</strong>
                  <small>{a.nota}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CURSOS DO SUPABASE -->

  <section class="seccao">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">Oferta formativa</span>

          <h2>Cursos Profissionais</h2>

          <p>
            Três anos de formação com equivalência ao 12.º ano
            e qualificação profissional de nível 4.
          </p>
        </div>

        <a href="/oferta-formativa/" class="ligacao-seta">
          Toda a oferta
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      <div class="grelha grelha--4">
        {
          profissionais.map((c) => (
            <CartaoCurso curso={c} />
          ))
        }
      </div>

      <div class="cef">
        <div>
          <h3>Cursos de Educação e Formação</h3>

          <p>
            Para jovens com mais de 15 anos que querem
            concluir o 9.º ano com uma certificação profissional.
          </p>
        </div>

        <ul>
          {
            cef.map((c) => (
              <li>
                <a href={`/oferta-formativa/${c.slug}/`}>
                  <Icone
                    nome={c.icone || 'formacao'}
                    tamanho={18}
                  />
                  {c.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="seccao seccao--suave">
    <div class="contentor">
      <Apoios />
    </div>
  </section>

  <section class="seccao">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">Porquê a EPF</span>
          <h2>{site.lema}</h2>
        </div>

        <a href="/escola/" class="ligacao-seta">
          Conhecer a escola
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      <Image
        src={alunos}
        alt="Alunos da escola nas escadas da entrada"
        widths={[640, 960, 1400, 1681]}
        sizes="(max-width: 1240px) 100vw, 1180px"
        class="foto-alunos"
      />

      <div class="grelha grelha--3">
        {
          pilares.map((p) => (
            <div class="cartao">
              <div class="icone-caixa">
                <Icone nome={p.icone} />
              </div>

              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NOTÍCIAS DO MARKDOWN + SUPABASE -->

  <section class="seccao seccao--suave">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">Notícias</span>
          <h2>O que se passa na escola</h2>
        </div>

        <a href="/noticias/" class="ligacao-seta">
          Todas as notícias
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      <div class="grelha grelha--3">
        {
          noticias.map((n) => (
            <CartaoNoticia noticia={n} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS EVENTOS DO SUPABASE -->

  <section class="seccao eventos-inicio">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">Agenda da escola</span>
          <h2>Próximos eventos</h2>
          <p>
            Acompanha as atividades, iniciativas e acontecimentos
            da Escola Profissional do Fundão.
          </p>
        </div>

        <a href="/eventos/" class="ligacao-seta">
          Todos os eventos
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      {
        eventos.length > 0 ? (
          <div class="grelha grelha--3">
            {eventos.map((evento) => (
              <article class="evento-cartao">
                <a
                  href={`/eventos/${evento.id}/`}
                  class="evento-cartao__ligacao"
                >
                  {evento.imagem_url ? (
                    <img
                      src={evento.imagem_url}
                      alt={`Imagem do evento ${evento.titulo}`}
                      class="evento-cartao__imagem"
                      loading="lazy"
                    />
                  ) : (
                    <div class="evento-cartao__sem-imagem">
                      <span>EPF</span>
                      <strong>Eventos</strong>
                    </div>
                  )}

                  <div class="evento-cartao__conteudo">
                    <time datetime={evento.data_inicio}>
                      {formatarDataEvento(evento.data_inicio)}
                    </time>

                    <h3>{evento.titulo}</h3>

                    {evento.local && (
                      <p class="evento-cartao__local">
                        {evento.local}
                      </p>
                    )}

                    <span class="evento-cartao__ver">
                      Ver detalhes
                      <Icone nome="seta" tamanho={16} />
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="eventos-vazio">
            <p>
              De momento, não existem próximos eventos anunciados.
            </p>

            <a href="/eventos/" class="ligacao-seta">
              Consultar todos os eventos
              <Icone nome="seta" tamanho={18} />
            </a>
          </div>
        )
      }

      <div class="eventos-inicio__rodape">
        <a href="/calendario/" class="botao botao--primario">
          Consultar calendário
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ERASMUS+ -->

  <section class="europa">
    <Image
      src={fundoErasmus}
      alt=""
      widths={[640, 960, 1400, 2000]}
      sizes="100vw"
      class="europa__fundo"
    />

    <div class="contentor">
      <div class="europa__texto">
        <span class="sobretitulo">
          Erasmus+ · #SomosEuropa
        </span>

        <h2>
          Um projeto de formação, também europeu.
        </h2>

        <p>
          Desde 1998 que a EPF possibilita estágios europeus
          a alunos, graduados e professores. Em 2016 recebeu
          o Certificado de Qualidade VET Mobility Charter.
        </p>

        <dl class="numeros">
          {
            erasmus.map((n) => (
              <div>
                <dt>{n.valor}</dt>
                <dd>{n.rotulo}</dd>
              </div>
            ))
          }
        </dl>

        <a
          href="/erasmus/"
          class="botao botao--primario"
        >
          Saber mais
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
    </div>

    <div class="europa__logotipos">
      <Image
        src={logotiposErasmus}
        alt="Escola Profissional do Fundão — Proximidade, Qualidade e Confiança. Erasmus+ Portugal, Educação e Formação. Erasmus+: enriquecer vidas, alargar horizontes."
        widths={[640, 1180, 2000]}
        sizes="(max-width: 1240px) 100vw, 1180px"
      />
    </div>
  </section>

  <ChamadaInscricoes />
</Base>

<style>
  .heroi {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(34rem, 52vw, 44rem);
    background-color: var(--petroleo);
    color: #e4ece9;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(6rem, 10vw, 8rem);
    overflow: hidden;
  }

  .heroi__fundo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .heroi::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(13 33 31 / 0.88) 0%,
        rgb(13 33 31 / 0.66) 45%,
        rgb(13 33 31 / 0.2) 100%
      ),
      linear-gradient(
        0deg,
        rgb(13 33 31 / 0.55) 0%,
        transparent 35%
      );
  }

  .heroi__dentro {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .heroi h1 {
    color: #fff;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 1.5rem;
  }

  .heroi h1 em {
    font-style: normal;
    color: var(--verde);
  }

  .heroi p {
    font-size: 1.2rem;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .heroi__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .heroi__numeros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--raio-g);
    background: rgb(13 33 31 / 0.55);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .heroi__numeros > div {
    padding: 1.4rem 1.5rem;
    border: 0 solid rgb(255 255 255 / 0.14);
  }

  .heroi__numeros > div:nth-child(odd) {
    border-right-width: 1px;
  }

  .heroi__numeros > div:nth-child(-n + 2) {
    border-bottom-width: 1px;
  }

  .heroi__numeros dt {
    font-family: var(--fonte-titulo);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
  }

  .heroi__numeros dd {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
  }

  .atalhos {
    margin-top: -2.75rem;
    position: relative;
  }

  .atalhos ul {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--linha);
    border-radius: var(--raio-g);
    box-shadow: var(--sombra);
    overflow: hidden;
  }

  .atalhos li + li {
    border-left: 1px solid var(--linha);
  }

  .atalhos a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.25rem 1.1rem;
    color: var(--petroleo);
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .atalhos a:hover {
    background: var(--verde-claro);
  }

  .atalhos a :global(svg) {
    color: var(--verde-escuro);
  }

  .atalhos strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .atalhos small {
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .foto-alunos {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: center 35%;
    border-radius: var(--raio-g);
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .foto-alunos {
      aspect-ratio: 3 / 2;
    }
  }

  .cef {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--raio-g);
    background: var(--fundo-suave);
    border: 1px solid var(--linha);
  }

  .cef h3 {
    margin-bottom: 0.25rem;
  }

  .cef p {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.95rem;
    max-width: 55ch;
  }

  .cef ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cef a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--linha);
    color: var(--petroleo);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .cef a:hover {
    border-color: var(--verde);
  }

  /* Eventos na página inicial */

  .eventos-inicio {
    background: #fff;
  }

  .evento-cartao {
    min-width: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--linha);
    border-radius: var(--raio-g);
    box-shadow: 0 8px 24px rgb(13 33 31 / 0.06);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .evento-cartao:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra);
  }

  .evento-cartao__ligacao {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--texto);
    text-decoration: none;
  }

  .evento-cartao__imagem,
  .evento-cartao__sem-imagem {
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .evento-cartao__sem-imagem {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, #164b3a, #267a4b);
    color: #fff;
  }

  .evento-cartao__sem-imagem span {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    opacity: 0.8;
  }

  .evento-cartao__sem-imagem strong {
    font-size: 1.8rem;
  }

  .evento-cartao__conteudo {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .evento-cartao__conteudo time {
    color: var(--verde-escuro);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .evento-cartao__conteudo h3 {
    margin: 0;
    color: var(--petroleo);
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .evento-cartao__local {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.9rem;
  }

  .evento-cartao__ver {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--verde-escuro);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .eventos-vazio {
    padding: 2rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio-g);
    background: var(--fundo-suave);
  }

  .eventos-vazio p {
    margin-top: 0;
  }

  .eventos-inicio__rodape {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .evento-cartao__imagem,
    .evento-cartao__sem-imagem {
      height: 190px;
    }
  }

  /* Erasmus+ */

  .europa {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(32rem, 46vw, 42rem);
    padding-top: clamp(3.5rem, 8vw, 6rem);
    background: #0b2a4d;
    color: #e3ecf5;
    overflow: hidden;
  }

  .europa__fundo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
