---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Apoios from '../components/Apoios.astro';
import edificio from '../assets/escola/edificio.webp';
import fundoErasmus from '../assets/erasmus-bandeiras.webp';
import logotiposErasmus from '../assets/erasmus-logotipos-claro.webp';
import alunos from '../assets/escola/alunos-entrada.webp';
import Icone from '../components/Icone.astro';
import CartaoCurso from '../components/CartaoCurso.astro';
import CartaoNoticia from '../components/CartaoNoticia.astro';
import ChamadaInscricoes from '../components/ChamadaInscricoes.astro';
import { site, erasmus } from '../data/site';
import { criarSupabaseServer } from '../lib/supabase/server';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const supabase = criarSupabaseServer(Astro);

// CONTEÚDOS PUBLICADOS DA PÁGINA INICIAL

const { data: paginaInicial, error: erroPaginaInicial } =
  await supabase
    .from('paginas_conteudo')
    .select('conteudo')
    .eq('slug', 'inicio')
    .eq('publicado', true)
    .maybeSingle();

if (erroPaginaInicial) {
  console.error(
    'Erro ao carregar conteúdos da Página Inicial:',
    erroPaginaInicial.message
  );
}

const conteudo: Record<string, unknown> =
  paginaInicial?.conteudo &&
  typeof paginaInicial.conteudo === 'object' &&
  !Array.isArray(paginaInicial.conteudo)
    ? paginaInicial.conteudo as Record<string, unknown>
    : {};

const texto = (chave: string, original: string): string => {
  const valor = conteudo[chave];

  return typeof valor === 'string' && valor.trim()
    ? valor.trim()
    : original;
};

// CARROSSEL DA PÁGINA INICIAL

type ImagemHeroi = {
  url: string;
  alt: string;
};

const enderecoImagemValido = (valor: string): boolean => {
  const endereco = valor.trim();

  if (endereco.startsWith('/') && !endereco.startsWith('//')) {
    return true;
  }

  try {
    const url = new URL(endereco);
    return url.protocol === 'https:';
  } catch {
    return false;
  }
};

const imagensGuardadas = Array.isArray(conteudo.heroi_imagens)
  ? conteudo.heroi_imagens
  : [];

const imagensHeroi: ImagemHeroi[] = imagensGuardadas
  .map((item: unknown): ImagemHeroi | null => {
    if (typeof item === 'string') {
      const url = item.trim();

      return enderecoImagemValido(url)
        ? {
            url,
            alt: 'Escola Profissional do Fundão',
          }
        : null;
    }

    if (
      !item ||
      typeof item !== 'object' ||
      Array.isArray(item)
    ) {
      return null;
    }

    const imagem = item as Record<string, unknown>;

    const url =
      typeof imagem.url === 'string'
        ? imagem.url.trim()
        : '';

    if (!enderecoImagemValido(url)) {
      return null;
    }

    return {
      url,
      alt:
        typeof imagem.alt === 'string' && imagem.alt.trim()
          ? imagem.alt.trim()
          : 'Escola Profissional do Fundão',
    };
  })
  .filter((imagem): imagem is ImagemHeroi => imagem !== null);

const temImagensPublicadas = imagensHeroi.length > 0;
const temCarrossel = imagensHeroi.length > 1;

// FOTOGRAFIA DOS ALUNOS — CONTEÚDO PUBLICADO

const imagemAlunosPublicada =
  typeof conteudo.imagem_alunos === 'string' &&
  enderecoImagemValido(conteudo.imagem_alunos)
    ? conteudo.imagem_alunos.trim()
    : '';

// CURSOS — MÓDULO ORIGINAL

const { data: cursosSupabase, error: erroCursos } = await supabase
  .from('cursos')
  .select('id, slug, titulo, tipo, area, nivel, duracao, icone, cartazes, ordem')
  .eq('publicado', true)
  .order('ordem', { ascending: true });

if (erroCursos) {
  console.error(
    'Erro ao carregar cursos da página inicial:',
    erroCursos.message
  );
}

const cursos = cursosSupabase ?? [];

const profissionais = cursos.filter(
  (c) => c.tipo === 'profissional'
);

const cef = cursos.filter(
  (c) => c.tipo === 'cef'
);

// NOTÍCIAS — MÓDULO ORIGINAL

const noticiasMarkdown = await getCollection('noticias');

const { data: noticiasSupabase, error: erroNoticias } = await supabase
  .from('noticias')
  .select('id, titulo, resumo, imagem_url, criado_em, publicada')
  .eq('publicada', true)
  .order('criado_em', { ascending: false });

if (erroNoticias) {
  console.error(
    'Erro ao carregar notícias da página inicial:',
    erroNoticias.message
  );
}

const noticias = [
  ...noticiasMarkdown,
  ...(noticiasSupabase ?? []),
]
  .sort((a, b) => {
    const dataA = 'criado_em' in a
      ? new Date(a.criado_em).getTime()
      : new Date(a.data.data).getTime();

    const dataB = 'criado_em' in b
      ? new Date(b.criado_em).getTime()
      : new Date(b.data.data).getTime();

    return dataB - dataA;
  })
  .slice(0, 3);

// EVENTOS — MÓDULO ORIGINAL

const agora = new Date().toISOString();

const { data: eventosSupabase, error: erroEventos } = await supabase
  .from('eventos')
  .select('id, titulo, descricao, data_inicio, data_fim, local, imagem_url')
  .eq('publicado', true)
  .gte('data_inicio', agora)
  .order('data_inicio', { ascending: true })
  .limit(3);

if (erroEventos) {
  console.error(
    'Erro ao carregar eventos da página inicial:',
    erroEventos.message
  );
}

const eventos = eventosSupabase ?? [];

const formatarDataEvento = (valor: string) =>
  new Intl.DateTimeFormat('pt-PT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Lisbon',
  }).format(new Date(valor));

// TEXTOS DA APRESENTAÇÃO PRINCIPAL

const heroiSobretitulo = texto(
  'heroi_sobretitulo',
  site.assinatura
);

const heroiTitulo = texto(
  'heroi_titulo',
  'Formação profissional na Cova da Beira'
);

const heroiDestaque = texto(
  'heroi_destaque',
  `desde ${site.fundacao}.`
);

const heroiDescricao = texto(
  'heroi_descricao',
  'Cursos com dupla certificação, ensino gratuito, estágios em empresas e mobilidade europeia.'
);

const botaoInscricoes = texto(
  'botao_inscricoes',
  'Inscreve-te'
);

const botaoOferta = texto(
  'botao_oferta',
  'Ver oferta formativa'
);

// INDICADORES

const destaques = [
  {
    valor: String(site.fundacao),
    rotulo: texto('destaque_1_rotulo', 'Ano de fundação'),
  },
  {
    valor: String(profissionais.length),
    rotulo: texto('destaque_2_rotulo', 'Cursos profissionais'),
  },
  {
    valor: erasmus[0].valor,
    rotulo: 'Mobilidades Erasmus+',
  },
  {
    valor: erasmus[3].valor,
    rotulo: 'Países de destino',
  },
];

// ATALHOS

const atalhos = [
  {
    nome: texto('atalho_1_nome', 'Cursos Profissionais'),
    nota: texto('atalho_1_nota', 'Nível 4 · 12.º ano'),
    url: '/oferta-formativa/#profissionais',
    icone: 'capelo',
  },
  {
    nome: texto('atalho_2_nome', 'Cursos CEF'),
    nota: texto('atalho_2_nota', 'Nível 2 · 9.º ano'),
    url: '/oferta-formativa/#cef',
    icone: 'chave',
  },
  {
    nome: texto('atalho_3_nome', 'Erasmus+'),
    nota: texto('atalho_3_nota', 'Estágios na Europa'),
    url: '/erasmus/',
    icone: 'globo',
  },
  {
    nome: texto('atalho_4_nome', 'Qualidade EQAVET'),
    nota: texto('atalho_4_nota', 'Selo e relatórios'),
    url: '/qualidade/',
    icone: 'selo',
  },
  {
    nome: texto('atalho_5_nome', 'Documentos'),
    nota: texto('atalho_5_nota', 'Regulamentos e calendário'),
    url: '/escola/documentos/',
    icone: 'documento',
  },
  {
    nome: texto('atalho_6_nome', 'Recrutamento'),
    nota: texto('atalho_6_nota', 'Emprego e estágios'),
    url: '/comunidade/#recrutamento',
    icone: 'pasta',
  },
];

// OFERTA FORMATIVA

const ofertaSobretitulo = texto(
  'oferta_sobretitulo',
  'Oferta formativa'
);

const ofertaTitulo = texto(
  'oferta_titulo',
  'Cursos Profissionais'
);

const ofertaDescricao = texto(
  'oferta_descricao',
  'Três anos de formação com equivalência ao 12.º ano e qualificação profissional de nível 4.'
);

const cefTitulo = texto(
  'cef_titulo',
  'Cursos de Educação e Formação'
);

const cefDescricao = texto(
  'cef_descricao',
  'Para jovens com mais de 15 anos que querem concluir o 9.º ano com uma certificação profissional.'
);

// PORQUÊ A EPF

const porqueSobretitulo = texto(
  'porque_sobretitulo',
  'Porquê a EPF'
);

const porqueTitulo = texto(
  'porque_titulo',
  site.lema
);

const pilares = [
  {
    titulo: texto(
      'pilar_1_titulo',
      'Aprender uma profissão'
    ),
    texto: texto(
      'pilar_1_texto',
      'Além das disciplinas científicas e socioculturais, os cursos têm uma forte componente técnica, com estágios e práticas em contexto de trabalho. Quem sai da EPF sai com uma profissão.'
    ),
    icone: 'pasta',
  },
  {
    titulo: texto(
      'pilar_2_titulo',
      'Prosseguir estudos'
    ),
    texto: texto(
      'pilar_2_texto',
      'A frequência de uma escola profissional é compatível com a entrada no ensino superior. Os nossos alunos já estão rotinados com métodos de trabalho que encontrarão mais tarde.'
    ),
    icone: 'capelo',
  },
  {
    titulo: texto(
      'pilar_3_titulo',
      'Ligação ao território'
    ),
    texto: texto(
      'pilar_3_texto',
      'Mantemos protocolos de colaboração com o poder local, a sociedade civil, associações e empresas, e uma rede europeia de parceiros para estágios internacionais.'
    ),
    icone: 'pessoas',
  },
];

// NOTÍCIAS E EVENTOS — APENAS TEXTOS DAS SECÇÕES

const noticiasSobretitulo = texto(
  'noticias_sobretitulo',
  'Notícias'
);

const noticiasTitulo = texto(
  'noticias_titulo',
  'O que se passa na escola'
);

const eventosSobretitulo = texto(
  'eventos_sobretitulo',
  'Agenda da escola'
);

const eventosTitulo = texto(
  'eventos_titulo',
  'Próximos eventos'
);

const eventosDescricao = texto(
  'eventos_descricao',
  'Acompanha as atividades, iniciativas e acontecimentos da Escola Profissional do Fundão.'
);
---

<Base>
  <!-- APRESENTAÇÃO PRINCIPAL COM CARROSSEL -->

  <section
    class="heroi"
    data-heroi
    aria-label="Apresentação da Escola Profissional do Fundão"
  >
    <div
      class="heroi__imagens"
      data-carrossel
      data-automatico={temCarrossel ? 'true' : 'false'}
    >
      {
        temImagensPublicadas ? (
          imagensHeroi.map((imagem, indice) => (
            <div
              class:list={[
                'heroi__slide',
                { 'heroi__slide--ativo': indice === 0 },
              ]}
              data-slide
              aria-hidden={indice !== 0 ? 'true' : 'false'}
            >
              <img
                src={imagem.url}
                alt=""
                class="heroi__fundo"
                loading={indice === 0 ? 'eager' : 'lazy'}
                fetchpriority={indice === 0 ? 'high' : 'auto'}
              />
            </div>
          ))
        ) : (
          <div
            class="heroi__slide heroi__slide--ativo"
            data-slide
            aria-hidden="false"
          >
            <Image
              src={edificio}
              alt=""
              widths={[640, 960, 1280, 1600]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              class="heroi__fundo"
            />
          </div>
        )
      }
    </div>

    <div class="contentor heroi__dentro">
      <div class="heroi__texto">
        <span class="sobretitulo">{heroiSobretitulo}</span>

        <h1>
          {heroiTitulo}
          <em>{heroiDestaque}</em>
        </h1>

        <p>{heroiDescricao}</p>

        <div class="heroi__acoes">
          <a href="/inscricoes/" class="botao botao--primario">
            {botaoInscricoes}
            <Icone nome="seta" tamanho={18} />
          </a>

          <a
            href="/oferta-formativa/"
            class="botao botao--contorno-claro"
          >
            {botaoOferta}
          </a>
        </div>
      </div>

      <dl class="heroi__numeros">
        {
          destaques.map((d) => (
            <div>
              <dt>{d.valor}</dt>
              <dd>{d.rotulo}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      temCarrossel && (
        <div
          class="heroi__navegacao"
          aria-label="Controlos do carrossel"
          data-controlos
        >
          <button
            type="button"
            class="heroi__seta"
            data-anterior
            aria-label="Fotografia anterior"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>

          <div
            class="heroi__indicadores"
            aria-label="Escolher fotografia"
          >
            {imagensHeroi.map((_, indice) => (
              <button
                type="button"
                class:list={[
                  'heroi__indicador',
                  {
                    'heroi__indicador--ativo': indice === 0,
                  },
                ]}
                data-indicador
                data-indice={indice}
                aria-label={`Mostrar fotografia ${indice + 1}`}
                aria-current={indice === 0 ? 'true' : 'false'}
              />
            ))}
          </div>

          <button
            type="button"
            class="heroi__seta"
            data-seguinte
            aria-label="Fotografia seguinte"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      )
    }
  </section>

  <!-- ATALHOS -->

  <section class="atalhos" aria-label="Acesso rápido">
    <div class="contentor">
      <ul>
        {
          atalhos.map((a) => (
            <li>
              <a href={a.url}>
                <Icone nome={a.icone} />

                <span>
                  <strong>{a.nome}</strong>
                  <small>{a.nota}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CURSOS DO SUPABASE -->

  <section class="seccao">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">{ofertaSobretitulo}</span>

          <h2>{ofertaTitulo}</h2>

          <p>{ofertaDescricao}</p>
        </div>

        <a href="/oferta-formativa/" class="ligacao-seta">
          Toda a oferta
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      <div class="grelha grelha--4">
        {
          profissionais.map((c) => (
            <CartaoCurso curso={c} />
          ))
        }
      </div>

      <div class="cef">
        <div>
          <h3>{cefTitulo}</h3>

          <p>{cefDescricao}</p>
        </div>

        <ul>
          {
            cef.map((c) => (
              <li>
                <a href={`/oferta-formativa/${c.slug}/`}>
                  <Icone
                    nome={c.icone || 'formacao'}
                    tamanho={18}
                  />
                  {c.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- APOIOS -->

  <section class="seccao seccao--suave">
    <div class="contentor">
      <Apoios />
    </div>
  </section>

  <!-- PORQUÊ A EPF -->

  <section class="seccao">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">{porqueSobretitulo}</span>
          <h2>{porqueTitulo}</h2>
        </div>

        <a href="/escola/" class="ligacao-seta">
          Conhecer a escola
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      {
        imagemAlunosPublicada ? (
          <img
            src={imagemAlunosPublicada}
            alt="Alunos da Escola Profissional do Fundão"
            class="foto-alunos"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={alunos}
            alt="Alunos da escola nas escadas da entrada"
            widths={[640, 960, 1400, 1681]}
            sizes="(max-width: 1240px) 100vw, 1180px"
            class="foto-alunos"
          />
        )
      }

      <div class="grelha grelha--3">
        {
          pilares.map((p) => (
            <div class="cartao">
              <div class="icone-caixa">
                <Icone nome={p.icone} />
              </div>

              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NOTÍCIAS DO MARKDOWN + SUPABASE -->

  <section class="seccao seccao--suave">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">{noticiasSobretitulo}</span>
          <h2>{noticiasTitulo}</h2>
        </div>

        <a href="/noticias/" class="ligacao-seta">
          Todas as notícias
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      <div class="grelha grelha--3">
        {
          noticias.map((n) => (
            <CartaoNoticia noticia={n} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS EVENTOS DO SUPABASE -->

  <section class="seccao eventos-inicio">
    <div class="contentor">
      <div class="cabecalho-seccao">
        <div>
          <span class="sobretitulo">{eventosSobretitulo}</span>
          <h2>{eventosTitulo}</h2>
          <p>{eventosDescricao}</p>
        </div>

        <a href="/eventos/" class="ligacao-seta">
          Todos os eventos
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>

      {
        eventos.length > 0 ? (
          <div class="grelha grelha--3">
            {eventos.map((evento) => (
              <article class="evento-cartao">
                <a
                  href={`/eventos/${evento.id}/`}
                  class="evento-cartao__ligacao"
                >
                  {evento.imagem_url ? (
                    <img
                      src={evento.imagem_url}
                      alt={`Imagem do evento ${evento.titulo}`}
                      class="evento-cartao__imagem"
                      loading="lazy"
                    />
                  ) : (
                    <div class="evento-cartao__sem-imagem">
                      <span>EPF</span>
                      <strong>Eventos</strong>
                    </div>
                  )}

                  <div class="evento-cartao__conteudo">
                    <time datetime={evento.data_inicio}>
                      {formatarDataEvento(evento.data_inicio)}
                    </time>

                    <h3>{evento.titulo}</h3>

                    {evento.local && (
                      <p class="evento-cartao__local">
                        {evento.local}
                      </p>
                    )}

                    <span class="evento-cartao__ver">
                      Ver detalhes
                      <Icone nome="seta" tamanho={16} />
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="eventos-vazio">
            <p>
              De momento, não existem próximos eventos anunciados.
            </p>

            <a href="/eventos/" class="ligacao-seta">
              Consultar todos os eventos
              <Icone nome="seta" tamanho={18} />
            </a>
          </div>
        )
      }

      <div class="eventos-inicio__rodape">
        <a href="/calendario/" class="botao botao--primario">
          Consultar calendário
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ERASMUS+ — SEM ALTERAÇÕES -->

  <section class="europa">
    <Image
      src={fundoErasmus}
      alt=""
      widths={[640, 960, 1400, 2000]}
      sizes="100vw"
      class="europa__fundo"
    />

    <div class="contentor">
      <div class="europa__texto">
        <span class="sobretitulo">
          Erasmus+ · #SomosEuropa
        </span>

        <h2>
          Um projeto de formação, também europeu.
        </h2>

        <p>
          Desde 1998 que a EPF possibilita estágios europeus
          a alunos, graduados e professores. Em 2016 recebeu
          o Certificado de Qualidade VET Mobility Charter.
        </p>

        <dl class="numeros">
          {
            erasmus.map((n) => (
              <div>
                <dt>{n.valor}</dt>
                <dd>{n.rotulo}</dd>
              </div>
            ))
          }
        </dl>

        <a
          href="/erasmus/"
          class="botao botao--primario"
        >
          Saber mais
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
    </div>

    <div class="europa__logotipos">
      <Image
        src={logotiposErasmus}
