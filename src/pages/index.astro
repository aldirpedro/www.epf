<script>
  function iniciarCarrosselHeroi() {
    const heroi = document.querySelector<HTMLElement>(
      '[data-heroi]'
    );

    if (!heroi || heroi.dataset.iniciado === 'true') {
      return;
    }

    heroi.dataset.iniciado = 'true';

    const carrossel = heroi.querySelector<HTMLElement>(
      '[data-carrossel]'
    );

    if (!carrossel) {
      return;
    }

    const slides = Array.from(
      carrossel.querySelectorAll<HTMLElement>('[data-slide]')
    );

    const indicadores = Array.from(
      heroi.querySelectorAll<HTMLButtonElement>(
        '[data-indicador]'
      )
    );

    const anterior =
      heroi.querySelector<HTMLButtonElement>('[data-anterior]');

    const seguinte =
      heroi.querySelector<HTMLButtonElement>('[data-seguinte]');

    if (slides.length < 2) {
      return;
    }

    let indiceAtual = 0;
    let temporizador: number | undefined;

    const prefereMenosMovimento = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    const mostrarSlide = (novoIndice: number) => {
      indiceAtual =
        (novoIndice + slides.length) % slides.length;

      slides.forEach((slide, indice) => {
        const ativo = indice === indiceAtual;

        slide.classList.toggle(
          'heroi__slide--ativo',
          ativo
        );

        slide.setAttribute(
          'aria-hidden',
          ativo ? 'false' : 'true'
        );
      });

      indicadores.forEach((indicador, indice) => {
        const ativo = indice === indiceAtual;

        indicador.classList.toggle(
          'heroi__indicador--ativo',
          ativo
        );

        indicador.setAttribute(
          'aria-current',
          ativo ? 'true' : 'false'
        );
      });
    };

    const pararAutomatico = () => {
      if (temporizador !== undefined) {
        window.clearInterval(temporizador);
        temporizador = undefined;
      }
    };

    const iniciarAutomatico = () => {
      pararAutomatico();

      if (
        document.hidden ||
        prefereMenosMovimento.matches
      ) {
        return;
      }

      temporizador = window.setInterval(() => {
        mostrarSlide(indiceAtual + 1);
      }, 5000);
    };

    const reiniciarAutomatico = () => {
      iniciarAutomatico();
    };

    anterior?.addEventListener('click', () => {
      mostrarSlide(indiceAtual - 1);
      reiniciarAutomatico();
    });

    seguinte?.addEventListener('click', () => {
      mostrarSlide(indiceAtual + 1);
      reiniciarAutomatico();
    });

    indicadores.forEach((indicador, indice) => {
      indicador.addEventListener('click', () => {
        mostrarSlide(indice);
        reiniciarAutomatico();
      });
    });

    heroi.addEventListener('mouseenter', pararAutomatico);

    heroi.addEventListener('mouseleave', iniciarAutomatico);

    heroi.addEventListener('focusin', pararAutomatico);

    heroi.addEventListener('focusout', (evento) => {
      const destino = evento.relatedTarget;

      if (
        destino instanceof Node &&
        heroi.contains(destino)
      ) {
        return;
      }

      iniciarAutomatico();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        pararAutomatico();
      } else {
        iniciarAutomatico();
      }
    });

    prefereMenosMovimento.addEventListener(
      'change',
      iniciarAutomatico
    );

    mostrarSlide(0);
    iniciarAutomatico();
  }

  iniciarCarrosselHeroi();

  document.addEventListener(
    'astro:page-load',
    iniciarCarrosselHeroi
  );
</script>

