
---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { criarSupabaseServer } from "../../../lib/supabase/server";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const supabase = criarSupabaseServer(Astro);

const {
  data: { user },
  error: erroAutenticacao,
} = await supabase.auth.getUser();

if (erroAutenticacao || !user) {
  return Astro.redirect("/admin/login");
}

const { data: perfil, error: erroPerfil } = await supabase
  .from("perfis")
  .select("nome, perfil, ativo")
  .eq("id", user.id)
  .single();

if (erroPerfil || !perfil?.ativo) {
  return Astro.redirect("/admin");
}

// Verificar se o utilizador tem permissão para criar notícias.
const {
  data: permissaoCriar,
  error: erroPermissaoCriar,
} = await supabase.rpc("tem_permissao", {
  p_recurso: "noticias",
  p_acao: "criar",
});

if (
  erroPermissaoCriar ||
  permissaoCriar !== true
) {
  return Astro.redirect("/admin/noticias/");
}

// A permissão para publicar é independente da criação.
const {
  data: permissaoPublicar,
  error: erroPermissaoPublicar,
} = await supabase.rpc("tem_permissao", {
  p_recurso: "noticias",
  p_acao: "publicar",
});

const podePublicar =
  !erroPermissaoPublicar &&
  permissaoPublicar === true;

const nome = perfil.nome || "Utilizador";

const nomesCargos: Record<string, string> = {
  super_admin: "Super Administrador",
  coordenador: "Coordenador",
  audiovisuais: "Audiovisuais",
  secretaria: "Secretaria",
};

const nomeCargo =
  nomesCargos[perfil.perfil] || "Utilizador";

const erro = Astro.url.searchParams.has("erro");
---

<AdminLayout
  titulo="Nova Notícia"
  nome={nome}
  perfil={nomeCargo}
  ativo="noticias"
>
  <div class="pagina">
    <a class="voltar" href="/admin/noticias/">
      ← Voltar às notícias
    </a>

    <div class="cabecalho">
      <span class="sobretitulo">
        GESTÃO DE CONTEÚDOS
      </span>

      <h1>Criar nova notícia</h1>

      <p>
        Preenche os campos para adicionar uma notícia
        ao website da Escola Profissional do Fundão.
      </p>
    </div>

    {
      erro && (
        <div class="erro" role="alert">
          Não foi possível guardar a notícia.
          Verifica os dados e tenta novamente.
        </div>
      )
    }

    <form
      class="formulario"
      action="/admin/noticias/criar"
      method="POST"
      enctype="multipart/form-data"
    >
      <div class="formulario-topo">
        <h2>Informações da notícia</h2>

        <p>
          Os campos assinalados com * são obrigatórios.
        </p>
      </div>

      <div class="campo">
        <label for="titulo">
          Título da notícia *
        </label>

        <input
          id="titulo"
          name="titulo"
          type="text"
          maxlength="200"
          placeholder="Escreve o título da notícia"
          required
        />
      </div>

      <div class="campo">
        <label for="resumo">
          Resumo
        </label>

        <textarea
          id="resumo"
          name="resumo"
          rows="3"
          maxlength="500"
          placeholder="Escreve um pequeno resumo"
        ></textarea>
      </div>

      <div class="campo">
        <label for="conteudo">
          Conteúdo da notícia *
        </label>

        <textarea
          id="conteudo"
          name="conteudo"
          rows="12"
          placeholder="Escreve aqui o conteúdo completo da notícia"
          required
        ></textarea>
      </div>

      <div class="campo">
        <label for="imagem">
          Imagem da notícia
        </label>

        <input
          id="imagem"
          name="imagem"
          type="file"
          accept="image/jpeg,image/png,image/webp"
        />

        <p class="ajuda">
          Formatos permitidos: JPG, PNG ou WebP.
          Tamanho máximo: 5 MB.
        </p>

        <img
          id="preview"
          class="preview"
          alt="Pré-visualização da imagem selecionada"
          hidden
        />
      </div>

      <div class="publicacao">
        <label
          class:list={[
            "checkbox",
            !podePublicar && "checkbox-bloqueada",
          ]}
        >
          <input
            type="checkbox"
            name="publicada"
            value="true"
            disabled={!podePublicar}
          />

          <span>
            <strong>Publicar notícia</strong>

            <small>
              {
                podePublicar
                  ? "Se não selecionares esta opção, a notícia fica guardada como rascunho."
                  : "Não tens permissão para publicar notícias. A notícia será guardada como rascunho."
              }
            </small>
          </span>
        </label>
      </div>

      <div class="acoes">
        <a
          class="botao-cancelar"
          href="/admin/noticias/"
        >
          Cancelar
        </a>

        <button
          type="submit"
          class="botao-guardar"
        >
          Guardar notícia
        </button>
      </div>
    </form>
  </div>

  <script>
    const input =
      document.querySelector<HTMLInputElement>("#imagem");

    const preview =
      document.querySelector<HTMLImageElement>("#preview");

    let urlAnterior: string | null = null;

    input?.addEventListener("change", () => {
      if (!preview) return;

      if (urlAnterior) {
        URL.revokeObjectURL(urlAnterior);
        urlAnterior = null;
      }

      const ficheiro = input.files?.[0];

      if (
        !ficheiro ||
        !ficheiro.type.startsWith("image/")
      ) {
        preview.hidden = true;
        preview.removeAttribute("src");
        return;
      }

      urlAnterior = URL.createObjectURL(ficheiro);
      preview.src = urlAnterior;
      preview.hidden = false;
    });

    window.addEventListener("pagehide", () => {
      if (urlAnterior) {
        URL.revokeObjectURL(urlAnterior);
      }
    });
  </script>
</AdminLayout>

<style>
  .pagina {
    max-width: 920px;
  }

  .voltar {
    display: inline-block;
    margin-bottom: 25px;
    color: #75869a;
    font-size: 13px;
    font-weight: 600;
  }

  .voltar:hover {
    color: #267a4b;
  }

  .cabecalho {
    margin-bottom: 28px;
  }

  .sobretitulo {
    color: #34885c;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 9px 0;
    color: #152d43;
    font-size: clamp(28px, 3vw, 36px);
    letter-spacing: -0.04em;
  }

  .cabecalho p {
    margin: 0;
    color: #75869a;
    font-size: 14px;
    line-height: 1.7;
  }

  .formulario {
    overflow: hidden;
    background: white;
    border: 1px solid #e4eaf0;
    border-radius: 14px;
  }

  .formulario-topo {
    padding: 26px 30px;
    border-bottom: 1px solid #e4eaf0;
  }

  .formulario-topo h2 {
    margin: 0 0 7px;
    color: #172f46;
    font-size: 18px;
  }

  .formulario-topo p {
    margin: 0;
    color: #8291a2;
    font-size: 13px;
  }

  .campo {
    display: grid;
    gap: 10px;
    padding: 22px 30px 0;
  }

  .campo label {
    color: #25384b;
    font-size: 13px;
    font-weight: 700;
  }

  input[type="text"],
  textarea,
  input[type="file"] {
    width: 100%;
    padding: 13px;
    border: 1px solid #dce5ed;
    border-radius: 9px;
    background: white;
    color: #203247;
    font: inherit;
    font-size: 14px;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid #9bd2b0;
    outline-offset: 1px;
    border-color: #267a4b;
  }

  textarea {
    resize: vertical;
  }

  input[type="file"] {
    border-style: dashed;
    background: #f8fafc;
  }

  .ajuda {
    margin: 0;
    color: #8291a2;
    font-size: 12px;
  }

  .preview {
    width: 100%;
    max-height: 350px;
    object-fit: contain;
    border-radius: 10px;
    background: #f1f5f9;
  }

  .preview[hidden] {
    display: none;
  }

  .publicacao {
    margin: 26px 30px;
    padding: 20px;
    border: 1px solid #dcebe2;
    border-radius: 10px;
    background: #f7fbf8;
  }

  .checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }

  .checkbox-bloqueada {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .checkbox input {
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    accent-color: #267a4b;
  }

  .checkbox span {
    display: grid;
    gap: 5px;
  }

  .checkbox strong {
    color: #25384b;
    font-size: 14px;
  }

  .checkbox small {
    color: #75869a;
    font-size: 12px;
    line-height: 1.5;
  }

  .acoes {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding: 22px 30px;
    border-top: 1px solid #e4eaf0;
    background: #fbfcfd;
  }

  .botao-cancelar,
  .botao-guardar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    border-radius: 9px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
  }

  .botao-cancelar {
    border: 1px solid #dce5ed;
    background: white;
    color: #52667b;
  }

  .botao-cancelar:hover {
    background: #f1f5f9;
  }

  .botao-guardar {
    border: 0;
    background: #267a4b;
    color: white;
    cursor: pointer;
  }

  .botao-guardar:hover {
    background: #1d603b;
  }

  .erro {
    margin-bottom: 22px;
    padding: 15px 18px;
    border: 1px solid #fecaca;
    border-radius: 9px;
    background: #fff5f5;
    color: #b91c1c;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .formulario-topo,
    .campo {
      padding-left: 18px;
      padding-right: 18px;
    }

    .publicacao {
      margin-left: 18px;
      margin-right: 18px;
    }

    .acoes {
      padding: 18px;
      flex-direction: column-reverse;
    }

    .botao-cancelar,
    .botao-guardar {
      width: 100%;
    }
  }
</style>
