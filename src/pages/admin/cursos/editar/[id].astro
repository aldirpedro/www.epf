
---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { criarSupabaseServer } from "../../../../lib/supabase/server";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const supabase = criarSupabaseServer(Astro);

const {
  data: { user },
  error: erroAutenticacao,
} = await supabase.auth.getUser();

if (erroAutenticacao || !user) {
  return Astro.redirect("/admin/login");
}

const { data: perfil, error: erroPerfil } = await supabase
  .from("perfis")
  .select("nome, perfil, ativo")
  .eq("id", user.id)
  .single();

if (erroPerfil || !perfil?.ativo) {
  return Astro.redirect("/admin");
}

const { data: podeEditar, error: erroPermissaoEditar } =
  await supabase.rpc("tem_permissao", {
    p_recurso: "cursos",
    p_acao: "editar",
  });

if (erroPermissaoEditar || podeEditar !== true) {
  return Astro.redirect("/admin/cursos/");
}

const { data: podePublicar, error: erroPermissaoPublicar } =
  await supabase.rpc("tem_permissao", {
    p_recurso: "cursos",
    p_acao: "publicar",
  });

if (erroPermissaoPublicar) {
  console.error(
    "Erro ao verificar permissão de publicação:",
    erroPermissaoPublicar.message
  );
}

const id = Astro.params.id;

const { data: curso, error: erroCurso } = await supabase
  .from("cursos")
  .select("*")
  .eq("id", id)
  .single();

if (erroCurso || !curso) {
  return Astro.redirect("/admin/cursos/");
}

type Componente = {
  nome: string;
  disciplinas: string[];
};

const componentes: Componente[] = Array.isArray(curso.componentes)
  ? curso.componentes.filter(
      (item: unknown): item is Componente => {
        if (typeof item !== "object" || item === null) {
          return false;
        }

        const valor = item as Record<string, unknown>;

        return (
          typeof valor.nome === "string" &&
          Array.isArray(valor.disciplinas) &&
          valor.disciplinas.every(
            (disciplina) => typeof disciplina === "string"
          )
        );
      }
    )
  : [];

function obterDisciplinas(nome: string): string {
  const componente = componentes.find(
    (item) => item.nome === nome
  );

  return componente?.disciplinas.join("\n") ?? "";
}

const cartazAtual = curso.cartazes?.[0] ?? null;

const erroGuardar = Astro.url.searchParams.has("erro");
---

<AdminLayout
  titulo={`Editar Curso — ${curso.titulo}`}
  nome={perfil.nome || "Administração"}
  perfil={perfil.perfil === "super_admin" ? "Super Administrador" : perfil.perfil}
  ativo="cursos"
>
  <div class="pagina">
    <a class="voltar" href="/admin/cursos/">
      ← Voltar à gestão de cursos
    </a>

    <div class="cabecalho">
      <span class="sobretitulo">OFERTA FORMATIVA</span>

      <h1>Editar Curso</h1>

      <p>
        Altera os dados de <strong>{curso.titulo}</strong> e guarda
        as modificações. Se o curso estiver publicado, as alterações
        ficarão disponíveis no site público.
      </p>
    </div>

    {
      erroGuardar && (
        <div class="mensagem-erro" role="alert">
          Não foi possível guardar as alterações.
          Verifica os dados e tenta novamente.
        </div>
      )
    }

    <form
      class="formulario"
      action="/admin/cursos/atualizar"
      method="POST"
      enctype="multipart/form-data"
    >
      <input
        type="hidden"
        name="id"
        value={curso.id}
      />

      <!-- INFORMAÇÃO PRINCIPAL -->

      <fieldset>
        <legend>Informação principal</legend>

        <p class="secao-descricao">
          Identificação e organização do curso no site.
        </p>

        <div class="grelha">
          <div class="campo largo">
            <label for="titulo">Nome do curso *</label>

            <input
              id="titulo"
              name="titulo"
              type="text"
              required
              maxlength="200"
              value={curso.titulo}
            />
          </div>

          <div class="campo">
            <label for="sigla">Sigla</label>

            <input
              id="sigla"
              name="sigla"
              type="text"
              maxlength="20"
              value={curso.sigla ?? ""}
            />
          </div>

          <div class="campo">
            <label for="slug">
              Identificador do endereço (slug) *
            </label>

            <input
              id="slug"
              name="slug"
              type="text"
              required
              maxlength="120"
              pattern="[a-z0-9]+(-[a-z0-9]+)*"
              value={curso.slug}
            />

            <small>
              Alterar o slug também altera o endereço público do curso.
            </small>
          </div>

          <div class="campo">
            <label for="tipo">Tipo de curso *</label>

            <select id="tipo" name="tipo" required>
              <option
                value="profissional"
                selected={curso.tipo === "profissional"}
              >
                Curso Profissional
              </option>

              <option
                value="cef"
                selected={curso.tipo === "cef"}
              >
                Curso de Educação e Formação (CEF)
              </option>
            </select>
          </div>

          <div class="campo">
            <label for="area">Área de formação *</label>

            <input
              id="area"
              name="area"
              type="text"
              required
              value={curso.area}
            />
          </div>

          <div class="campo">
            <label for="icone">Ícone</label>

            <input
              id="icone"
              name="icone"
              type="text"
              value={curso.icone ?? "livro"}
            />
          </div>

          <div class="campo">
            <label for="ordem">Ordem de apresentação</label>

            <input
              id="ordem"
              name="ordem"
              type="number"
              min="0"
              step="1"
              value={curso.ordem ?? 0}
            />
          </div>
        </div>
      </fieldset>

      <!-- QUALIFICAÇÃO -->

      <fieldset>
        <legend>Qualificação e acesso</legend>

        <p class="secao-descricao">
          Informações sobre a duração, certificação
          e condições de entrada.
        </p>

        <div class="grelha">
          <div class="campo">
            <label for="nivel">Nível de qualificação *</label>

            <input
              id="nivel"
              name="nivel"
              type="text"
              required
              value={curso.nivel}
            />
          </div>

          <div class="campo">
            <label for="duracao">Duração *</label>

            <input
              id="duracao"
              name="duracao"
              type="text"
              required
              value={curso.duracao}
            />
          </div>

          <div class="campo largo">
            <label for="certificacao">Certificação *</label>

            <input
              id="certificacao"
              name="certificacao"
              type="text"
              required
              value={curso.certificacao}
            />
          </div>

          <div class="campo largo">
            <label for="acesso">Condições de acesso *</label>

            <input
              id="acesso"
              name="acesso"
              type="text"
              required
              value={curso.acesso}
            />
          </div>
        </div>
      </fieldset>

      <!-- DESCRIÇÃO -->

      <fieldset>
        <legend>Descrição do curso</legend>

        <p class="secao-descricao">
          Conteúdos apresentados na página pública do curso.
        </p>

        <div class="campo">
          <label for="perfil">Perfil profissional *</label>

          <textarea
            id="perfil"
            name="perfil"
            rows="5"
            required
          >{curso.perfil}</textarea>
        </div>

        <div class="campo">
          <label for="conteudo">Informação adicional</label>

          <textarea
            id="conteudo"
            name="conteudo"
            rows="6"
          >{curso.conteudo ?? ""}</textarea>
        </div>
      </fieldset>

      <!-- PLANO DE FORMAÇÃO -->

      <fieldset>
        <legend>Plano de formação</legend>

        <p class="secao-descricao">
          Escreve uma disciplina por linha em cada componente.
        </p>

        <div class="campo">
          <label for="sociocultural">
            Formação Sociocultural
          </label>

          <textarea
            id="sociocultural"
            name="sociocultural"
            rows="5"
          >{obterDisciplinas("Formação Sociocultural")}</textarea>
        </div>

        <div class="campo">
          <label for="cientifica">
            Formação Científica
          </label>

          <textarea
            id="cientifica"
            name="cientifica"
            rows="4"
          >{obterDisciplinas("Formação Científica")}</textarea>
        </div>

        <div class="campo">
          <label for="tecnica">
            Formação Técnica
          </label>

          <textarea
            id="tecnica"
            name="tecnica"
            rows="5"
          >{obterDisciplinas("Formação Técnica")}</textarea>
        </div>

        <div class="campo">
          <label for="fct">
            Formação em Contexto de Trabalho
          </label>

          <textarea
            id="fct"
            name="fct"
            rows="3"
          >{obterDisciplinas("Formação em Contexto de Trabalho")}</textarea>
        </div>
      </fieldset>

      <!-- IMAGEM -->

      <fieldset>
        <legend>Imagem do curso</legend>

        <p class="secao-descricao">
          Podes manter o cartaz atual ou carregar uma nova imagem.
        </p>

        {
          cartazAtual && (
            <div class="imagem-atual">
              <span class="imagem-legenda">Cartaz atual</span>

              <img
                src={cartazAtual}
                alt={`Cartaz atual de ${curso.titulo}`}
              />
            </div>
          )
        }

        <div class="campo">
          <label for="imagem">
            {cartazAtual ? "Substituir cartaz" : "Adicionar cartaz"}
          </label>

          <input
            id="imagem"
            name="imagem"
            type="file"
            accept="image/jpeg,image/png,image/webp"
          />

          <small>
            JPG, PNG ou WebP, até 5 MB.
            Deixa vazio para manter o cartaz atual.
          </small>
        </div>

        <img
          id="preview"
          class="preview"
          alt="Pré-visualização do novo cartaz"
          hidden
        />
      </fieldset>

      <!-- PUBLICAÇÃO -->

      <fieldset>
        <legend>Publicação</legend>

        <div class="publicacao">
          <label class="checkbox">
            <input
              type="checkbox"
              name="publicado"
              value="true"
              checked={curso.publicado}
              disabled={podePublicar !== true}
            />

            <span>
              <strong>Curso publicado</strong>

              <small>
                Os cursos publicados aparecem na Oferta Formativa
                do site público da EPF.
              </small>
            </span>
          </label>

          {
            podePublicar !== true && (
              <>
                <input
                  type="hidden"
                  name="publicado"
                  value={String(curso.publicado)}
                />

                <p class="aviso-permissao">
                  Não tens permissão para publicar ou despublicar cursos.
                  Podes guardar as restantes alterações.
                </p>
              </>
            )
          }
        </div>
      </fieldset>

      <!-- AÇÕES -->

      <div class="acoes">
        <a class="cancelar" href="/admin/cursos/">
          Cancelar
        </a>

        <button type="submit" class="guardar">
          Guardar alterações
        </button>
      </div>
    </form>
  </div>

  <script>
    const input =
      document.querySelector<HTMLInputElement>("#imagem");

    const preview =
      document.querySelector<HTMLImageElement>("#preview");

    let urlAnterior: string | null = null;

    input?.addEventListener("change", () => {
      if (!preview) return;

      if (urlAnterior) {
        URL.revokeObjectURL(urlAnterior);
        urlAnterior = null;
      }

      const ficheiro = input.files?.[0];

      if (!ficheiro || !ficheiro.type.startsWith("image/")) {
        preview.hidden = true;
        preview.removeAttribute("src");
        return;
      }

      urlAnterior = URL.createObjectURL(ficheiro);
      preview.src = urlAnterior;
      preview.hidden = false;
    });

    window.addEventListener("pagehide", () => {
      if (urlAnterior) {
        URL.revokeObjectURL(urlAnterior);
      }
    });
  </script>
</AdminLayout>

<style>
  .pagina {
    max-width: 1000px;
  }

  .voltar {
    display: inline-block;
    margin-bottom: 25px;
    color: #75869a;
    font-size: 13px;
    font-weight: 600;
  }

  .voltar:hover {
    color: #267a4b;
  }

  .cabecalho {
    margin-bottom: 28px;
  }

  .sobretitulo {
    color: #34885c;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 9px 0;
    color: #152d43;
    font-size: clamp(28px, 3vw, 36px);
    letter-spacing: -0.04em;
  }

  .cabecalho p {
    margin: 0;
    color: #75869a;
    font-size: 14px;
    line-height: 1.7;
  }

  .cabecalho strong {
    color: #25384b;
  }

  .mensagem-erro {
    margin-bottom: 22px;
    padding: 15px 18px;
    border: 1px solid #fecaca;
    border-radius: 9px;
    background: #fff5f5;
    color: #b91c1c;
    font-size: 13px;
  }

  .formulario {
    display: grid;
    gap: 22px;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 26px 30px;
    border: 1px solid #e4eaf0;
    border-radius: 14px;
    background: white;
  }

  legend {
    padding: 0 10px;
    color: #172f46;
    font-size: 18px;
    font-weight: 800;
  }

  .secao-descricao {
    margin: 0 0 25px;
    color: #8291a2;
    font-size: 13px;
    line-height: 1.6;
  }

  .grelha {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 20px;
  }

  .campo:last-child {
    margin-bottom: 0;
  }

  .largo {
    grid-column: 1 / -1;
  }

  label {
    color: #25384b;
    font-size: 13px;
    font-weight: 700;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #dce5ed;
    border-radius: 9px;
    background: white;
    color: #203247;
    font: inherit;
    font-size: 14px;
  }

  input[type="file"] {
    border-style: dashed;
    background: #f8fafc;
    cursor: pointer;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid #9bd2b0;
    outline-offset: 1px;
    border-color: #267a4b;
  }

  textarea {
    resize: vertical;
  }

  small {
    color: #8291a2;
    font-size: 12px;
    line-height: 1.6;
  }

  .imagem-atual {
    margin-bottom: 24px;
  }

  .imagem-legenda {
    display: block;
    margin-bottom: 12px;
    color: #25384b;
    font-size: 13px;
    font-weight: 700;
  }

  .imagem-atual img {
    display: block;
    width: 220px;
    max-width: 100%;
    height: auto;
    border: 1px solid #e4eaf0;
    border-radius: 10px;
  }

  .preview {
    display: block;
    width: 220px;
    max-width: 100%;
    max-height: 350px;
    margin-top: 16px;
    object-fit: contain;
    border: 1px solid #e4eaf0;
    border-radius: 10px;
    background: #f1f5f9;
  }

  .preview[hidden] {
    display: none;
  }

  .publicacao {
    padding: 20px;
    border: 1px solid #dcebe2;
    border-radius: 10px;
    background: #f7fbf8;
  }

  .checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }

  .checkbox input {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin: 2px 0 0;
    accent-color: #267a4b;
  }

  .checkbox span {
    display: grid;
    gap: 5px;
  }

  .checkbox strong {
    color: #25384b;
    font-size: 14px;
  }

  .checkbox small {
    color: #75869a;
  }

  .aviso-permissao {
    margin: 12px 0 0;
    color: #8a6532;
    font-size: 12px;
    line-height: 1.6;
  }

  .acoes {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding: 24px;
    border: 1px solid #e4eaf0;
    border-radius: 14px;
    background: white;
  }

  .cancelar,
  .guardar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    border-radius: 9px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
  }

  .cancelar {
    border: 1px solid #dce5ed;
    background: white;
    color: #52667b;
  }

  .cancelar:hover {
    background: #f1f5f9;
  }

  .guardar {
    border: 0;
    background: #267a4b;
    color: white;
    cursor: pointer;
  }

  .guardar:hover {
    background: #1d603b;
  }

  @media (max-width: 650px) {
    .grelha {
      grid-template-columns: 1fr;
    }

    .largo {
      grid-column: auto;
    }

    fieldset {
      padding: 22px 18px;
    }

    .acoes {
      flex-direction: column-reverse;
      padding: 18px;
    }

    .cancelar,
    .guardar {
      width: 100%;
    }
  }
</style>
