
---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { criarSupabaseServer } from "../../../lib/supabase/server";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const perfilAdmin = Astro.locals.perfilAdmin;

if (!perfilAdmin?.ativo || perfilAdmin.perfil !== "super_admin") {
  return Astro.redirect("/admin/");
}

const supabase = criarSupabaseServer(Astro);

const { data: utilizadores, error } = await supabase
  .from("perfis")
  .select("id, nome, perfil, ativo, criado_em")
  .order("criado_em", { ascending: false });

const nomesCargos: Record<string, string> = {
  super_admin: "Super Administrador",
  coordenador: "Coordenador",
  audiovisuais: "Audiovisuais",
  secretaria: "Secretaria",
};

const totalUtilizadores = utilizadores?.length ?? 0;
const totalAtivos =
  utilizadores?.filter((utilizador) => utilizador.ativo).length ?? 0;
---

<AdminLayout
  titulo="Gestão de Utilizadores"
  nome={perfilAdmin.nome || "Administrador"}
  perfil="Super Administrador"
  ativo="utilizadores"
>
  <div class="pagina-utilizadores">
    <div class="cabecalho">
      <div>
        <span class="etiqueta">ADMINISTRAÇÃO</span>
        <h1>Utilizadores</h1>
        <p>
          Consulta as contas da escola, adiciona funcionários e gere
          as suas permissões individuais.
        </p>
      </div>

      <a href="/admin/utilizadores/novo" class="botao-novo">
        + Nova conta
      </a>
    </div>

    <div class="estatisticas">
      <div class="cartao">
        <span>Total de utilizadores</span>
        <strong>{totalUtilizadores}</strong>
      </div>

      <div class="cartao">
        <span>Contas ativas</span>
        <strong>{totalAtivos}</strong>
      </div>
    </div>

    <section class="painel">
      <div class="painel-topo">
        <div>
          <h2>Contas registadas</h2>
          <p>
            Utilizadores com perfil administrativo na EPF.
          </p>
        </div>
      </div>

      {
        error ? (
          <div class="mensagem erro">
            Não foi possível carregar os utilizadores.
            Verifica as políticas de acesso no Supabase.
          </div>
        ) : !utilizadores?.length ? (
          <div class="mensagem">
            Ainda não existem utilizadores registados.
          </div>
        ) : (
          <div class="tabela-scroll">
            <table>
              <thead>
                <tr>
                  <th>Utilizador</th>
                  <th>Cargo</th>
                  <th>Estado</th>
                  <th>Permissões</th>
                </tr>
              </thead>

              <tbody>
                {utilizadores.map((utilizador) => (
                  <tr>
                    <td>
                      <div class="identidade">
                        <span class="avatar">
                          {(utilizador.nome || "U")
                            .charAt(0)
                            .toUpperCase()}
                        </span>

                        <div>
                          <strong>
                            {utilizador.nome || "Sem nome"}
                          </strong>

                          {utilizador.id === perfilAdmin.id && (
                            <small>A tua conta</small>
                          )}
                        </div>
                      </div>
                    </td>

                    <td>
                      {nomesCargos[utilizador.perfil] ||
                        utilizador.perfil}
                    </td>

                    <td>
                      <span
                        class:list={[
                          "estado",
                          utilizador.ativo ? "ativo" : "inativo",
                        ]}
                      >
                        {utilizador.ativo ? "Ativo" : "Inativo"}
                      </span>
                    </td>

                    <td>
                      {utilizador.perfil === "super_admin" ? (
                        <span class="acesso-total">
                          Acesso total
                        </span>
                      ) : (
                        <a
                          class="botao-permissoes"
                          href={`/admin/utilizadores/editar/${utilizador.id}`}
                        >
                          Editar permissões ↗
                        </a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
</AdminLayout>

<style>
  .pagina-utilizadores {
    max-width: 1250px;
    margin: 0 auto;
  }

  .cabecalho {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 28px;
  }

  .etiqueta {
    color: #34885c;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 10px 0;
    color: #172f46;
    font-size: clamp(28px, 3vw, 36px);
    letter-spacing: -0.04em;
  }

  .cabecalho p {
    margin: 0;
    color: #75869a;
    font-size: 14px;
    line-height: 1.7;
  }

  .botao-novo {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 9px;
    background: #267a4b;
    color: white;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .botao-novo:hover {
    background: #1c603a;
  }

  .estatisticas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 24px;
  }

  .cartao,
  .painel {
    background: white;
    border: 1px solid #e4eaf0;
    border-radius: 14px;
    box-shadow: 0 5px 22px rgb(23 50 76 / 0.025);
  }

  .cartao {
    padding: 24px;
    display: grid;
    gap: 10px;
  }

  .cartao span {
    color: #8291a2;
    font-size: 13px;
  }

  .cartao strong {
    color: #172f46;
    font-size: 32px;
  }

  .painel {
    overflow: hidden;
  }

  .painel-topo {
    padding: 24px;
    border-bottom: 1px solid #edf1f5;
  }

  .painel-topo h2 {
    margin: 0 0 6px;
    color: #172f46;
    font-size: 18px;
  }

  .painel-topo p {
    margin: 0;
    color: #8291a2;
    font-size: 13px;
  }

  .tabela-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    padding: 15px 24px;
    background: #f8fafc;
    color: #75869a;
    font-size: 12px;
    font-weight: 700;
  }

  td {
    padding: 18px 24px;
    border-top: 1px solid #edf1f5;
    color: #33485c;
    font-size: 13px;
  }

  .identidade {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e6f5ec;
    color: #267a4b;
    display: grid;
    place-items: center;
    font-weight: 800;
  }

  .identidade strong {
    display: block;
    color: #203247;
  }

  .identidade small {
    display: block;
    margin-top: 4px;
    color: #8291a2;
  }

  .estado {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
  }

  .estado.ativo {
    background: #e6f5ec;
    color: #24744d;
  }

  .estado.inativo {
    background: #f2f3f5;
    color: #7c8793;
  }

  .acesso-total {
    color: #24744d;
    font-weight: 700;
  }

  .botao-permissoes {
    display: inline-block;
    padding: 9px 13px;
    border-radius: 8px;
    background: #e6f5ec;
    color: #24744d;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .botao-permissoes:hover {
    background: #d1ebdb;
  }

  .mensagem {
    padding: 28px;
    color: #75869a;
    font-size: 14px;
  }

  .mensagem.erro {
    color: #b42318;
  }

  @media (max-width: 650px) {
    .estatisticas {
      grid-template-columns: 1fr;
    }

    th,
    td {
      padding: 14px;
    }

    .botao-novo {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>
