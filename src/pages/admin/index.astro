---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { criarSupabaseServer } from "../../lib/supabase/server";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const supabase = criarSupabaseServer(Astro);

const {
  data: { user },
  error: erroAutenticacao,
} = await supabase.auth.getUser();

if (erroAutenticacao || !user) {
  return Astro.redirect("/admin/login");
}

const { data: perfil, error: erroPerfil } = await supabase
  .from("perfis")
  .select("nome, perfil, ativo")
  .eq("id", user.id)
  .single();

if (erroPerfil || !perfil?.ativo) {
  return Astro.redirect("/admin/login?erro=acesso");
}

const eSuperAdmin = perfil.perfil === "super_admin";

const nome = perfil.nome || "Utilizador";

const nomesCargos: Record<string, string> = {
  super_admin: "Super Administrador",
  coordenador: "Coordenador",
  audiovisuais: "Audiovisuais",
  secretaria: "Secretaria",
};

const nomePerfil =
  nomesCargos[perfil.perfil] || perfil.perfil;

// Consultar as permissões reais do Supabase.
// Estas verificações aplicam-se automaticamente a qualquer conta.

const recursos = ["noticias", "cursos", "documentacao"] as const;

const acoes = [
  "ver",
  "criar",
  "editar",
  "eliminar",
  "publicar",
] as const;

type Recurso = (typeof recursos)[number];
type Acao = (typeof acoes)[number];

const verificacoes = recursos.flatMap((recurso) =>
  acoes.map((acao) => ({ recurso, acao }))
);

const resultados = await Promise.all(
  verificacoes.map(({ recurso, acao }) =>
    supabase.rpc("tem_permissao", {
      p_recurso: recurso,
      p_acao: acao,
    })
  )
);

const permissoes: Record<
  Recurso,
  Record<Acao, boolean>
> = {
  noticias: {
    ver: false,
    criar: false,
    editar: false,
    eliminar: false,
    publicar: false,
  },
  cursos: {
    ver: false,
    criar: false,
    editar: false,
    eliminar: false,
    publicar: false,
  },
  documentacao: {
    ver: false,
    criar: false,
    editar: false,
    eliminar: false,
    publicar: false,
  },
};

verificacoes.forEach(({ recurso, acao }, indice) => {
  const resultado = resultados[indice];

  permissoes[recurso][acao] =
    resultado.error === null &&
    resultado.data === true;
});

const podeCriarNoticias = permissoes.noticias.criar;
const podeCriarCursos = permissoes.cursos.criar;
const podeCriarDocumentos = permissoes.documentacao.criar;

const podeAcederNoticias =
  Object.values(permissoes.noticias).some(Boolean);

const podeAcederCursos =
  Object.values(permissoes.cursos).some(Boolean);

const podeAcederDocumentacao =
  Object.values(permissoes.documentacao).some(Boolean);

const temAlgumAcesso =
  podeAcederNoticias ||
  podeAcederCursos ||
  podeAcederDocumentacao ||
  eSuperAdmin;

// Estatísticas: consultar apenas os recursos autorizados.

let totalNoticias: number | null = null;
let totalCursos: number | null = null;
let noticiasPublicadas: number | null = null;
let cursosPublicados: number | null = null;

if (podeAcederNoticias) {
  const [noticias, noticiasAtivas] = await Promise.all([
    supabase
      .from("noticias")
      .select("id", { count: "exact", head: true }),

    supabase
      .from("noticias")
      .select("id", { count: "exact", head: true })
      .eq("publicada", true),
  ]);

  if (!noticias.error) {
    totalNoticias = noticias.count;
  }

  if (!noticiasAtivas.error) {
    noticiasPublicadas = noticiasAtivas.count;
  }
}

if (podeAcederCursos) {
  const [cursos, cursosAtivos] = await Promise.all([
    supabase
      .from("cursos")
      .select("id", { count: "exact", head: true }),

    supabase
      .from("cursos")
      .select("id", { count: "exact", head: true })
      .eq("publicado", true),
  ]);

  if (!cursos.error) {
    totalCursos = cursos.count;
  }

  if (!cursosAtivos.error) {
    cursosPublicados = cursosAtivos.count;
  }
}
---

<AdminLayout
  titulo="Painel Administrativo"
  nome={nome}
  perfil={nomePerfil}
  ativo="inicio"
>
  <div class="dashboard">
    <div class="cabecalho">
      <div>
        <span class="sobretitulo">
          PAINEL DE CONTROLO
        </span>

        <h1>Visão geral</h1>

        <p>
          Bem-vindo, {nome}. Gere os conteúdos da Escola
          Profissional do Fundão a partir deste painel.
        </p>
      </div>

      <a
        class="botao-secundario"
        href="/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver website ↗
      </a>
    </div>

    {
      temAlgumAcesso ? (
        <>
          <section
            class="estatisticas"
            aria-label="Resumo de conteúdos"
          >
            {
              podeAcederNoticias && (
                <article class="cartao-estatistica">
                  <div class="estatistica-topo">
                    <span class="icone icone-azul">
                      ▤
                    </span>

                    <span class="indicador">
                      Notícias
                    </span>
                  </div>

                  <strong class="numero">
                    {totalNoticias ?? "—"}
                  </strong>

                  <p>
                    {
                      noticiasPublicadas === null
                        ? "Estado indisponível"
                        : `${noticiasPublicadas} publicadas`
                    }
                  </p>
                </article>
              )
            }

            {
              podeAcederCursos && (
                <article class="cartao-estatistica">
                  <div class="estatistica-topo">
                    <span class="icone icone-verde">
                      ▧
                    </span>

                    <span class="indicador">
                      Cursos
                    </span>
                  </div>

                  <strong class="numero">
                    {totalCursos ?? "—"}
                  </strong>

                  <p>
                    {
                      cursosPublicados === null
                        ? "Estado indisponível"
                        : `${cursosPublicados} publicados`
                    }
                  </p>
                </article>
              )
            }

            {
              eSuperAdmin && (
                <article class="cartao-estatistica">
                  <div class="estatistica-topo">
                    <span class="icone icone-laranja">
                      ▦
                    </span>

                    <span class="indicador">
                      Eventos
                    </span>
                  </div>

                  <strong class="numero">—</strong>

                  <p>
                    Gestão em preparação
                  </p>
                </article>
              )
            }
          </section>

          <div class="grelha-inferior">
            <section class="painel">
              <div class="painel-cabecalho">
                <h2>Acesso rápido</h2>

                <p>
                  As operações disponíveis para a tua conta
                </p>
              </div>

              <div class="atalhos">
                {
                  podeCriarNoticias && (
                    <a href="/admin/noticias/nova">
                      <span class="atalho-icone">
                        ＋
                      </span>

                      <span class="atalho-texto">
                        <strong>
                          Nova notícia
                        </strong>

                        <small>
                          Adicionar uma novidade da escola
                        </small>
                      </span>

                      <span class="seta">↗</span>
                    </a>
                  )
                }

                {
                  podeCriarCursos && (
                    <a href="/admin/cursos/novo">
                      <span class="atalho-icone">
                        ＋
                      </span>

                      <span class="atalho-texto">
                        <strong>
                          Novo curso
                        </strong>

                        <small>
                          Adicionar uma oferta formativa
                        </small>
                      </span>

                      <span class="seta">↗</span>
                    </a>
                  )
                }

                {
                  podeCriarDocumentos && (
                    <a href="/admin/documentacao/novo">
                      <span class="atalho-icone">
                        ＋
                      </span>

                      <span class="atalho-texto">
                        <strong>
                          Novo documento
                        </strong>

                        <small>
                          Adicionar um documento institucional
                        </small>
                      </span>

                      <span class="seta">↗</span>
                    </a>
                  )
                }

                {
                  podeAcederNoticias && (
                    <a href="/admin/noticias/">
                      <span class="atalho-icone">
                        ▤
                      </span>

                      <span class="atalho-texto">
                        <strong>
                          Gerir notícias
                        </strong>

                        <small>
                          Consultar e gerir notícias
                          conforme as tuas permissões
                        </small>
                      </span>

                      <span class="seta">↗</span>
                    </a>
                  )
                }

                {
                  podeAcederCursos && (
                    <a href="/admin/cursos/">
                      <span class="atalho-icone">
                        ▧
                      </span>

                      <span class="atalho-texto">
                        <strong>
                          Gerir cursos
                        </strong>

                        <small>
                          Consultar e gerir a oferta formativa
                        </small>
                      </span>

                      <span class="seta">↗</span>
                    </a>
                  )
                }

                {
                  podeAcederDocumentacao && (
                    <a href="/admin/documentacao/">
                      <span class="atalho-icone">
                        ▤
                      </span>

                      <span class="atalho-texto">
                        <strong>
                          Gerir documentação
                        </strong>

                        <small>
                          Consultar e gerir documentos
                          conforme as tuas permissões
                        </small>
                      </span>

                      <span class="seta">↗</span>
                    </a>
                  )
                }

                {
                  eSuperAdmin && (
                    <>
                      <a href="/admin/utilizadores/">
                        <span class="atalho-icone">
                          ♙
                        </span>

                        <span class="atalho-texto">
                          <strong>
                            Gerir utilizadores
                          </strong>

                          <small>
                            Contas e permissões individuais
                          </small>
                        </span>

                        <span class="seta">↗</span>
                      </a>

                      <a href="/admin/utilizadores/novo">
                        <span class="atalho-icone">
                          ＋
                        </span>

                        <span class="atalho-texto">
                          <strong>
                            Nova conta
                          </strong>

                          <small>
                            Adicionar um funcionário da escola
                          </small>
                        </span>

                        <span class="seta">↗</span>
                      </a>
                    </>
                  )
                }
              </div>
            </section>

            <section class="painel painel-ajuda">
              <h2>Gestão de conteúdos</h2>

              <p>
                As alterações aos cursos e às notícias
                são guardadas no Supabase.
              </p>

              <div class="informacao">
                <span class="ponto-verde"></span>

                <span>
                  Os conteúdos publicados ficam disponíveis
                  no website público.
                </span>
              </div>

              <div class="informacao">
                <span class="ponto-cinzento"></span>

                <span>
                  Os conteúdos não publicados ficam ocultos
                  dos visitantes.
                </span>
              </div>

              {
                eSuperAdmin && (
                  <div class="informacao">
                    <span class="ponto-verde"></span>

                    <span>
                      Como Super Administrador, podes criar
                      contas e configurar as permissões
                      dos funcionários.
                    </span>
                  </div>
                )
              }
            </section>
          </div>
        </>
      ) : (
        <section class="painel">
          <h2>Área reservada</h2>

          <p>
            A tua sessão está ativa com o perfil
            de {nomePerfil.toLowerCase()}.
          </p>

          <p>
            Ainda não tens acesso às ferramentas
            disponíveis neste painel.
          </p>

          <p>
            Contacta o Super Administrador para
            configurar as tuas permissões.
          </p>
        </section>
      )
    }
  </div>
</AdminLayout>

<style>
  /* ==================================================
     1. ESTRUTURA E VARIÁVEIS VISUAIS
     ================================================== */

  .dashboard {
    --dashboard-verde: var(--admin-verde, #267a4b);
    --dashboard-fundo: var(--admin-superficie, #ffffff);
    --dashboard-texto: var(--admin-texto, #203247);
    --dashboard-secundario: var(
      --admin-texto-secundario,
      #75869a
    );
    --dashboard-borda: var(--admin-borda, #e4eaf0);

    --dashboard-raio: 0.875rem;
    --dashboard-espaco: clamp(1rem, 2vw, 1.5rem);

    width: 100%;
    max-width: 84.375rem;
    min-width: 0;
    margin-inline: auto;
  }

  /* ==================================================
     2. CABEÇALHO DA PÁGINA
     ================================================== */

  .cabecalho {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;

    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .cabecalho > div {
    flex: 1;
    min-width: 0;
  }

  .sobretitulo {
    display: inline-block;

    color: var(--dashboard-verde);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.5;
  }

  h1 {
    margin: 0.5rem 0 0.625rem;

    color: #152d43;

    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .cabecalho p {
    max-width: 42rem;
    margin: 0;

    color: var(--dashboard-secundario);

    font-size: 0.875rem;
    line-height: 1.7;
  }

  .botao-secundario {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    flex: 0 0 auto;

    min-height: 2.75rem;
    padding: 0.75rem 1rem;

    border: 1px solid #dce5ed;
    border-radius: 0.625rem;

    background: var(--dashboard-fundo);
    color: #243e55;

    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;

    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .botao-secundario:hover {
    border-color: var(--dashboard-verde);
    background: #f7fbf8;
    color: var(--dashboard-verde);
  }

  .botao-secundario:focus-visible {
    outline: 3px solid #a7d9bd;
    outline-offset: 3px;
  }

  /* ==================================================
     3. GRELHA DE ESTATÍSTICAS
     ================================================== */

  .estatisticas {
    display: grid;

    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, 13.5rem), 1fr)
    );

    gap: var(--dashboard-espaco);
    margin-bottom: var(--dashboard-espaco);
  }

  /* Superfície comum a cartões e painéis. */
  .cartao-estatistica,
  .painel {
    min-width: 0;

    background: var(--dashboard-fundo);
    border: 1px solid var(--dashboard-borda);
    border-radius: var(--dashboard-raio);

    box-shadow: 0 0.25rem 1.25rem rgb(23 50 76 / 0.025);
  }

  .cartao-estatistica {
    display: flex;
    flex-direction: column;

    min-height: 10.5rem;

    padding: clamp(1.125rem, 2vw, 1.5rem);
  }

  .estatistica-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .icone {
    display: grid;
    place-items: center;

    width: 2.625rem;
    height: 2.625rem;

    flex: 0 0 auto;

    border-radius: 0.6875rem;

    font-size: 1.375rem;
    line-height: 1;
  }

  .icone-azul {
    background: #e9f0fb;
    color: #3b6ba7;
  }

  .icone-verde {
    background: #e6f5ec;
    color: #258151;
  }

  .icone-laranja {
    background: #fff1e1;
    color: #ba7a28;
  }

  .indicador {
    min-width: 0;

    color: #687c90;

    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: right;
  }

  .numero {
    display: block;

    margin-top: 1rem;

    color: #172f46;

    font-size: clamp(1.875rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .cartao-estatistica p {
    margin: 0.375rem 0 0;

    color: var(--dashboard-secundario);

    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* ==================================================
     4. PAINÉIS INFERIORES
     ================================================== */

  .grelha-inferior {
    display: grid;

    grid-template-columns:
      minmax(0, 1.45fr)
      minmax(16rem, 1fr);

    align-items: start;
    gap: var(--dashboard-espaco);
  }

  .painel {
    padding: clamp(1.125rem, 2.2vw, 1.625rem);
  }

  .painel h2 {
    margin: 0 0 0.5rem;

    color: #172f46;

    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 750;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .painel p {
    margin-top: 0;

    color: var(--dashboard-secundario);

    font-size: 0.8125rem;
    line-height: 1.75;
  }

  .painel-cabecalho {
    margin-bottom: 1.25rem;
  }

  .painel-cabecalho p {
    margin: 0;
  }

  /* ==================================================
     5. ATALHOS ADMINISTRATIVOS
     ================================================== */

  .atalhos {
    display: grid;
    gap: 0.5rem;
  }

  .atalhos a {
    display: flex;
    align-items: center;
    gap: 0.875rem;

    min-width: 0;
    min-height: 4.5rem;

    padding: 0.875rem;

    border: 1px solid transparent;
    border-radius: 0.75rem;

    background: #f7f9fb;
    color: var(--dashboard-texto);

    text-decoration: none;

    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .atalhos a:hover {
    background: #f0f7f3;
    border-color: #d5e8db;
  }

  .atalhos a:focus-visible {
    outline: 3px solid #a7d9bd;
    outline-offset: 2px;
  }

  .atalho-icone {
    display: grid;
    place-items: center;

    width: 2.5rem;
    height: 2.5rem;

    flex: 0 0 auto;

    border-radius: 0.625rem;

    background: #e6f5ec;
    color: var(--dashboard-verde);

    font-size: 1.25rem;
    line-height: 1;
  }

  .atalho-texto {
    display: grid;
    gap: 0.25rem;

    flex: 1;
    min-width: 0;
  }

  .atalhos strong {
    color: #203247;

    font-size: 0.8125rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .atalhos small {
    color: #718397;

    font-size: 0.75rem;
    line-height: 1.5;

    overflow-wrap: anywhere;
  }

  .seta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    color: #8193a5;

    font-size: 1rem;

    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .atalhos a:hover .seta {
    color: var(--dashboard-verde);
    transform: translate(0.125rem, -0.125rem);
  }

  /* ==================================================
     6. PAINEL DE INFORMAÇÃO
     ================================================== */

  .painel-ajuda {
    align-self: start;
  }

  .painel-ajuda > p {
    margin-bottom: 1.25rem;
  }

  .informacao {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;

    margin-top: 1.125rem;

    color: #52667b;

    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .informacao > span:last-child {
    min-width: 0;
  }

  .ponto-verde,
  .ponto-cinzento {
    width: 0.5625rem;
    height: 0.5625rem;

    flex: 0 0 auto;

    margin-top: 0.375rem;
    border-radius: 50%;
  }

  .ponto-verde {
    background: #32a36b;
  }

  .ponto-cinzento {
    background: #aab7c4;
  }

  /* ==================================================
     7. TABLET E ECRÃS INTERMÉDIOS
     ================================================== */

  /*
    Com a barra lateral visível, a área útil
    do dashboard é menor do que a largura total
    do navegador. Por isso, os painéis passam
    a uma coluna antes de ficarem apertados.
  */
  @media (max-width: 1250px) {
    .grelha-inferior {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .cabecalho {
      gap: 1rem;
    }

    .estatisticas {
      grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, 12rem), 1fr)
      );
    }

    .painel {
      padding: 1.25rem;
    }
  }

  /* ==================================================
     8. TELEMÓVEL
     ================================================== */

  @media (max-width: 600px) {
    .cabecalho {
      flex-direction: column;
      align-items: stretch;

      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-size: clamp(1.625rem, 7vw, 2rem);
    }

    .cabecalho p {
      font-size: 0.8125rem;
    }

    .botao-secundario {
      align-self: flex-start;
    }

    .estatisticas {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .cartao-estatistica {
      min-height: 0;
      padding: 1.125rem;
    }

    .numero {
      margin-top: 0.75rem;
      font-size: 2rem;
    }

    .grelha-inferior {
      gap: 0.75rem;
    }

    .painel {
      padding: 1.125rem;
    }

    .painel-cabecalho {
      margin-bottom: 1rem;
    }

    .atalhos {
      gap: 0.5rem;
    }

    .atalhos a {
      gap: 0.75rem;
      padding: 0.75rem;
    }

    .atalho-icone {
      width: 2.25rem;
      height: 2.25rem;
    }

    .informacao {
      margin-top: 1rem;
    }
  }

  /* ==================================================
     9. ECRÃS MUITO ESTREITOS
     ================================================== */

  @media (max-width: 380px) {
    .painel {
      padding: 0.875rem;
    }

