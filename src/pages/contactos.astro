---
import Pagina from '../layouts/Pagina.astro';
import Icone from '../components/Icone.astro';
import { site } from '../data/site';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
  {
    auth: {
      persistSession: false,
      autoRefreshToken: false,
      detectSessionInUrl: false,
    },
  }
);

const { data: pagina, error } = await supabase
  .from('paginas_conteudo')
  .select('conteudo')
  .eq('slug', 'contactos')
  .eq('publicado', true)
  .maybeSingle();

if (error) {
  console.error('Erro ao carregar a página Contactos:', error.message);
}

const conteudo: Record<string, unknown> =
  pagina?.conteudo &&
  typeof pagina.conteudo === 'object' &&
  !Array.isArray(pagina.conteudo)
    ? pagina.conteudo
    : {};

const texto = (chave: string, original: string): string => {
  const valor = conteudo[chave];

  return typeof valor === 'string' && valor.trim()
    ? valor.trim()
    : original;
};

const tituloPagina = texto('titulo_pagina', 'Contactos');

const introducao = texto(
  'introducao',
  'Estamos disponíveis para esclarecer dúvidas sobre cursos, inscrições, parcerias e serviços da escola.'
);

const tituloFormulario = texto(
  'titulo_formulario',
  'Envia-nos uma mensagem'
);

const entidade = texto('entidade', site.entidade);

const moradaOriginal = site.morada.join('\n');

const morada = texto('morada', moradaOriginal)
  .split('\n')
  .map((linha) => linha.trim())
  .filter(Boolean);

const telefone = texto('telefone', site.telefone);

const email = texto('email', site.email);

const mapaPublicado = texto('mapa', site.mapa);

const mapa =
  /^https:\/\/(www\.)?(google\.[a-z.]+\/maps|maps\.google\.[a-z.]+\/)/i.test(mapaPublicado)
    ? mapaPublicado
    : site.mapa;
---

<Pagina titulo={tituloPagina} intro={introducao}>
  <section class="seccao">
    <div class="contentor duas-colunas">
      <div>
        <h2>{tituloFormulario}</h2>

        <form
          class="formulario"
          data-formulario="contacto"
          data-assunto="Contacto pelo sítio"
          data-email={email}
        >
          <div class="campo">
            <label for="c-nome">
              Nome <abbr title="obrigatório">*</abbr>
            </label>

            <input
              id="c-nome"
              name="nome"
              autocomplete="name"
              required
            />
          </div>

          <div class="campo">
            <label for="c-telefone">Telefone de contacto</label>

            <input
              id="c-telefone"
              name="telefone"
              type="tel"
              autocomplete="tel"
            />
          </div>

          <div class="campo">
            <label for="c-email">
              Email <abbr title="obrigatório">*</abbr>
            </label>

            <input
              id="c-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>

          <div class="campo">
            <label for="c-entidade">
              Empresa / Instituição <abbr title="obrigatório">*</abbr>
            </label>

            <input
              id="c-entidade"
              name="entidade"
              autocomplete="organization"
              required
            />
          </div>

          <div class="campo campo--largo">
            <label for="c-assunto">
              Assunto <abbr title="obrigatório">*</abbr>
            </label>

            <input
              id="c-assunto"
              name="assunto"
              required
            />
          </div>

          <div class="campo campo--largo">
            <label for="c-mensagem">
              Descrição <abbr title="obrigatório">*</abbr>
            </label>

            <textarea
              id="c-mensagem"
              name="descricao"
              required
            ></textarea>
          </div>

          <label class="consentimento campo--largo">
            <input
              type="checkbox"
              name="consentimento"
              value="sim"
              required
            />

            <span>
              Autorizo o tratamento destes dados para resposta
              ao meu pedido, nos termos da
              <a href="/privacidade/">política de privacidade</a>.
            </span>
          </label>

          <button type="submit" class="botao botao--escuro">
            Enviar <Icone nome="seta" tamanho={18} />
          </button>

          <p class="formulario__nota">
            Os campos assinalados com * são obrigatórios.
          </p>

          <p role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="painel">
        <h3>{entidade}</h3>

        <dl>
          <dt>Morada</dt>

          <dd>
            {morada.map((linha) => (
              <>
                {linha}
                <br />
              </>
            ))}
          </dd>

          <dt>Telefone</dt>

          <dd>
            <a href={`tel:${telefone.replace(/\s/g, '')}`}>
              {telefone}
            </a>
          </dd>

          <dt>Email</dt>

          <dd>
            <a href={`mailto:${email}`}>
              {email}
            </a>
          </dd>
        </dl>

        <p style="margin:1.25rem 0 0">
          <a
            href={mapa}
            class="ligacao-seta"
            rel="noopener"
          >
            Ver no Google Maps
            <Icone nome="externo" tamanho={16} />
          </a>
        </p>
      </aside>
    </div>
  </section>
</Pagina>

<script>
  // Permite ligações do tipo /contactos/?assunto=Parcerias
  const assunto = new URLSearchParams(location.search).get('assunto');

  const campo = document.querySelector<HTMLInputElement>('#c-assunto');

  if (assunto && campo) {
    campo.value = assunto;
  }
</script>