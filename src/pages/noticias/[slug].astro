---
import { getCollection, render } from 'astro:content';
import Pagina from '../../layouts/Pagina.astro';
import Icone from '../../components/Icone.astro';
import { mesAno } from '../../data/datas';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props;
const d = noticia.data;
const { Content } = await render(noticia);
---

<Pagina titulo={d.titulo} descricao={d.resumo} migalhas={[{ nome: 'Notícias', url: '/noticias/' }]}>
  <p slot="antes-titulo" class="meta">
    {d.categoria} · <time datetime={d.data.toISOString().slice(0, 10)}>{mesAno(d.data)}</time>
  </p>
  <article class="seccao">
    <div class="contentor">
      <div class="prosa">
        {d.imagem && <img src={d.imagem} alt="" />}
        <Content />
        {d.autor && <p class="autor">Publicado por {d.autor}</p>}
        <p><a href="/noticias/" class="ligacao-seta">Todas as notícias <Icone nome="seta" tamanho={18} /></a></p>
      </div>
    </div>
  </article>
</Pagina>

<style>
  .meta {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--verde);
    font-weight: 600;
  }
  .prosa {
    font-size: 1.08rem;
  }
  .autor {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linha);
    font-size: 0.9rem;
    color: var(--texto-suave);
  }
</style>
