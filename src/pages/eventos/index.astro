
---
import Pagina from '../../layouts/Pagina.astro';
import { criarSupabaseServer } from '../../lib/supabase/server';

export const prerender = false;

const supabase = criarSupabaseServer(Astro);

// Buscar apenas os eventos publicados no Supabase.
const { data, error } = await supabase
  .from('eventos')
  .select('id, titulo, descricao, data_inicio, data_fim, local, imagem_url')
  .eq('publicado', true)
  .order('data_inicio', { ascending: true });

const eventos = data ?? [];

const agora = new Date();

// Separar os eventos futuros dos eventos anteriores.
const futuros = eventos
  .filter((evento) => new Date(evento.data_inicio) >= agora)
  .sort(
    (a, b) =>
      new Date(a.data_inicio).getTime() -
      new Date(b.data_inicio).getTime()
  );

const passados = eventos
  .filter((evento) => new Date(evento.data_inicio) < agora)
  .sort(
    (a, b) =>
      new Date(b.data_inicio).getTime() -
      new Date(a.data_inicio).getTime()
  );

// Apresentar datas e horas no fuso horário de Portugal.
const fmt = new Intl.DateTimeFormat('pt-PT', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Lisbon',
});

const fmtHora = new Intl.DateTimeFormat('pt-PT', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Lisbon',
});
---

<Pagina
  titulo="Eventos e Atividades"
  descricao="Consulta as atividades da Escola Profissional do Fundão."
>
  <main class="contentor seccao">
    {
      error && (
        <p role="alert">
          Não foi possível carregar os eventos neste momento.
          Tenta novamente mais tarde.
        </p>
      )
    }

    {
      !error && (
        <>
          <section>
            <h2 class="sobretitulo">Próximos Eventos</h2>

            {futuros.length === 0 ? (
              <p>Não há eventos agendados de momento.</p>
            ) : (
              <div class="grelha grelha--3" style="margin-top: 1rem;">
                {futuros.map((evento) => (
                  <article class="cartao">
                    {evento.imagem_url && (
                      <img
                        src={evento.imagem_url}
                        alt=""
                        loading="lazy"
                        style="border-radius: 8px; margin-bottom: 1rem; aspect-ratio: 16/9; object-fit: cover;"
                      />
                    )}

                    <h3>{evento.titulo}</h3>

                    <p>{evento.descricao}</p>

                    <div
                      class="cartao__rodape"
                      style="flex-direction: column; align-items: flex-start; gap: 0.25rem;"
                    >
                      <span>
                        📅 {fmt.format(new Date(evento.data_inicio))}
                      </span>

                      <span>
                        🕒 {fmtHora.format(new Date(evento.data_inicio))}
                      </span>

                      <span>
                        📍 {evento.local || 'Local a definir'}
                      </span>
                    </div>

                    <a
                      href={`/eventos/${evento.id}/`}
                      class="cartao__ligacao"
                      aria-label={`Ver detalhes de ${evento.titulo}`}
                    ></a>
                  </article>
                ))}
              </div>
            )}
          </section>

          {passados.length > 0 && (
            <section style="margin-top: 4rem;">
              <details>
                <summary
                  style="cursor: pointer; font-size: 1.25rem; font-weight: bold; margin-bottom: 1rem; color: var(--petroleo);"
                >
                  Eventos Anteriores ({passados.length})
                </summary>

                <div class="grelha grelha--3">
                  {passados.map((evento) => (
                    <article class="cartao" style="opacity: 0.8;">
                      <h3>{evento.titulo}</h3>

                      <p>{evento.descricao}</p>

                      <div class="cartao__rodape">
                        <span>
                          📅 {fmt.format(new Date(evento.data_inicio))}
                        </span>
                      </div>

                      <a
                        href={`/eventos/${evento.id}/`}
                        class="cartao__ligacao"
                        aria-label={`Ver detalhes de ${evento.titulo}`}
                      ></a>
                    </article>
                  ))}
                </div>
              </details>
            </section>
          )}
        </>
      )
    }
  </main>
</Pagina>
