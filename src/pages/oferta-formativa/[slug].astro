---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Pagina from '../../layouts/Pagina.astro';
import Icone from '../../components/Icone.astro';
import { site, apoios } from '../../data/site';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map((curso) => ({ params: { slug: curso.id }, props: { curso } }));
}

const { curso } = Astro.props;
const d = curso.data;
const { Content } = await render(curso);
const tipo = d.tipo === 'profissional' ? 'Curso Profissional' : 'Curso de Educação e Formação';
---

<Pagina titulo={d.titulo} descricao={d.perfil} migalhas={[{ nome: 'Oferta formativa', url: '/oferta-formativa/' }]}>
  <span slot="antes-titulo" class="etiqueta">{tipo} · {d.area}</span>

  <section class="seccao">
    <div class="contentor duas-colunas">
      <div>
        <span class="sobretitulo">Perfil profissional</span>
        <p class="lead">{d.perfil}</p>
        <div class="prosa"><Content /></div>

        <h2>Plano de formação</h2>
        <div class="componentes">
          {
            d.componentes.map((c) => (
              <div class="componente">
                <h3>{c.nome}</h3>
                {c.disciplinas.length > 0 && (
                  <ul>
                    {c.disciplinas.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>

        {
          d.tipo === 'profissional' && (
            <>
              <h2>Apoios aos alunos</h2>
              <ul class="apoios">
                {apoios.map((a) => (
                  <li>{a.nome}</li>
                ))}
              </ul>
            </>
          )
        }

        {
          d.cartazes.length > 1 && (
            <div class="cartazes">
              {d.cartazes.slice(1).map((c) => (
                <Image src={c} alt={`Cartaz do curso ${d.titulo}`} widths={[400, 640, 900]} sizes="(max-width: 760px) 100vw, 420px" />
              ))}
            </div>
          )
        }
      </div>

      <div class="lateral">
        {
          d.cartazes[0] && (
            <Image
              src={d.cartazes[0]}
              alt={`Cartaz do curso ${d.titulo}`}
              widths={[400, 640, 900]}
              sizes="(max-width: 760px) 100vw, 420px"
              loading="eager"
              class="cartaz"
            />
          )
        }
      <aside class="painel">
        <h3>Informação do curso</h3>
        <dl>
          <dt>Qualificação</dt>
          <dd>{d.nivel}</dd>
          <dt>Duração</dt>
          <dd>{d.duracao}</dd>
          <dt>Certificação</dt>
          <dd>{d.certificacao}</dd>
          <dt>Condições de acesso</dt>
          <dd>{d.acesso}</dd>
        </dl>
        {
          site.inscricoes.abertas && (
            <a href={`/inscricoes/?curso=${curso.id}`} class="botao botao--escuro">
              Inscreve-te <Icone nome="seta" tamanho={18} />
            </a>
          )
        }
        <a href="/contactos/" class="ligacao-seta">Pedir informações</a>
      </aside>
      </div>
    </div>
  </section>
</Pagina>

<style>
  .etiqueta {
    margin-bottom: 1rem;
    background: rgb(98 173 66 / 0.18);
    color: var(--verde);
  }
  h2 {
    margin-top: 2.5rem;
    font-size: 1.6rem;
  }
  .componentes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .componente {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    border-left: 4px solid var(--verde);
  }
  .componente h3 {
    font-size: 1.05rem;
    margin: 0;
  }
  .componente ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.93rem;
    color: var(--texto-suave);
  }
  .apoios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .apoios li {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--verde-claro);
    color: var(--petroleo);
    font-size: 0.9rem;
    font-weight: 550;
  }
  .cartazes {
    margin-top: 2.5rem;
    max-width: 26rem;
  }
  .cartaz,
  .cartazes img {
    width: 100%;
    height: auto;
    border-radius: var(--raio-g);
  }
  .lateral {
    display: grid;
    gap: 1.25rem;
  }
  .lateral .painel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .lateral .botao {
    justify-content: center;
    margin-top: 0.75rem;
  }
  .lateral .ligacao-seta {
    justify-content: center;
    font-size: 0.93rem;
  }
</style>
