
---
import Pagina from '../../layouts/Pagina.astro';
import Icone from '../../components/Icone.astro';
import { site, apoios } from '../../data/site';
import { criarSupabaseServer } from '../../lib/supabase/server';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, must-revalidate'
);

const slug = Astro.params.slug ?? '';

const supabase = criarSupabaseServer(Astro);

// Procurar exclusivamente cursos publicados no Supabase.
const { data: curso, error } = await supabase
  .from('cursos')
  .select(
    'slug, titulo, tipo, area, nivel, duracao, certificacao, acesso, perfil, conteudo, componentes, cartazes'
  )
  .eq('slug', slug)
  .eq('publicado', true)
  .maybeSingle();

if (error) {
  console.error('Erro ao carregar curso:', error);
}

// Cursos inexistentes ou despublicados não ficam acessíveis.
if (!curso) {
  return Astro.rewrite('/404');
}

const d = curso;

const tipo =
  d.tipo === 'profissional'
    ? 'Curso Profissional'
    : 'Curso de Educação e Formação';

type Componente = {
  nome: string;
  disciplinas: string[];
};

// Validar os dados do plano de formação.
const componentes: Componente[] = Array.isArray(d.componentes)
  ? d.componentes
      .filter(
        (item) =>
          typeof item === 'object' &&
          item !== null &&
          !Array.isArray(item) &&
          typeof item.nome === 'string'
      )
      .map((item) => ({
        nome: item.nome as string,
        disciplinas: Array.isArray(item.disciplinas)
          ? item.disciplinas.filter(
              (disciplina): disciplina is string =>
                typeof disciplina === 'string'
            )
          : [],
      }))
  : [];

// Os cartazes do Supabase são URLs públicas.
const cartazes: string[] = Array.isArray(d.cartazes)
  ? d.cartazes.filter(
      (cartaz): cartaz is string =>
        typeof cartaz === 'string' && cartaz.length > 0
    )
  : [];

const cartazPrincipal = cartazes[0] ?? null;
const outrosCartazes = cartazes.slice(1);

// O conteúdo textual é guardado no Supabase.
const paragrafos = (d.conteudo ?? '')
  .split(/\n\s*\n/)
  .map((paragrafo) => paragrafo.trim())
  .filter(Boolean);
---

<Pagina
  titulo={d.titulo}
  descricao={d.perfil}
  migalhas={[{ nome: 'Oferta formativa', url: '/oferta-formativa/' }]}
>
  <span slot="antes-titulo" class="etiqueta">
    {tipo} · {d.area}
  </span>

  <section class="seccao">
    <div class="contentor duas-colunas">
      <div>
        <span class="sobretitulo">Perfil profissional</span>
        <p class="lead">{d.perfil}</p>

        {
          paragrafos.length > 0 && (
            <div class="prosa">
              {paragrafos.map((paragrafo) => (
                <p>{paragrafo}</p>
              ))}
            </div>
          )
        }

        <h2>Plano de formação</h2>

        <div class="componentes">
          {
            componentes.map((componente) => (
              <div class="componente">
                <h3>{componente.nome}</h3>

                {componente.disciplinas.length > 0 && (
                  <ul>
                    {componente.disciplinas.map((disciplina) => (
                      <li>{disciplina}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>

        {
          d.tipo === 'profissional' && (
            <>
              <h2>Apoios aos alunos</h2>

              <ul class="apoios">
                {apoios.map((apoio) => (
                  <li>{apoio.nome}</li>
                ))}
              </ul>
            </>
          )
        }

        {
          outrosCartazes.length > 0 && (
            <div class="cartazes">
              {outrosCartazes.map((cartaz) => (
                <img
                  src={cartaz}
                  alt={`Cartaz do curso ${d.titulo}`}
                  loading="lazy"
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="lateral">
        {
          cartazPrincipal && (
            <img
              src={cartazPrincipal}
              alt={`Cartaz do curso ${d.titulo}`}
              loading="eager"
              class="cartaz"
            />
          )
        }

        <aside class="painel">
          <h3>Informação do curso</h3>

          <dl>
            <dt>Qualificação</dt>
            <dd>{d.nivel}</dd>

            <dt>Duração</dt>
            <dd>{d.duracao}</dd>

            <dt>Certificação</dt>
            <dd>{d.certificacao}</dd>

            <dt>Condições de acesso</dt>
            <dd>{d.acesso}</dd>
          </dl>

          {
            site.inscricoes.abertas && (
              <a
                href={`/inscricoes/?curso=${slug}`}
                class="botao botao--escuro"
              >
                Inscreve-te
                <Icone nome="seta" tamanho={18} />
              </a>
            )
          }

          <a href="/contactos/" class="ligacao-seta">
            Pedir informações
          </a>
        </aside>
      </div>
    </div>
  </section>
</Pagina>

<style>
  .etiqueta {
    margin-bottom: 1rem;
    background: rgb(98 173 66 / 0.18);
    color: var(--verde);
  }

  h2 {
    margin-top: 2.5rem;
    font-size: 1.6rem;
  }

  .componentes {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, 260px), 1fr)
    );
    gap: 1rem;
  }

  .componente {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    border-left: 4px solid var(--verde);
  }

  .componente h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .componente ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.93rem;
    color: var(--texto-suave);
  }

  .apoios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apoios li {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--verde-claro);
    color: var(--petroleo);
    font-size: 0.9rem;
    font-weight: 550;
  }

  .cartazes {
    margin-top: 2.5rem;
    max-width: 26rem;
  }

  .cartaz,
  .cartazes img {
    width: 100%;
    height: auto;
    border-radius: var(--raio-g);
  }

  .lateral {
    display: grid;
    gap: 1.25rem;
  }

  .lateral .painel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lateral .botao {
    justify-content: center;
    margin-top: 0.75rem;
  }

  .lateral .ligacao-seta {
    justify-content: center;
    font-size: 0.93rem;
  }
</style>
