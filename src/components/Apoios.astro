---
import { apoios } from '../data/site';
import Icone from './Icone.astro';
---

<div class="apoios">
  <div>
    <span class="sobretitulo">Apoios aos alunos</span>
    <h2>Estudar na EPF é gratuito.</h2>
    <p>Os cursos são cofinanciados pela União Europeia através do Pessoas 2030 e os alunos contam com um conjunto de apoios durante a formação.</p>
  </div>
  <ul>
    {
      apoios.map((a) => (
        <li>
          <Icone nome={a.icone} tamanho={20} />
          {a.nome}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .apoios {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  p {
    margin: 0;
    color: var(--texto-suave);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 1rem;
    background: #fff;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    font-weight: 550;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  li :global(svg) {
    flex: none;
    color: var(--verde-escuro);
  }
  @media (max-width: 820px) {
    .apoios {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
