---
import { site } from '../data/site';
import Icone from './Icone.astro';
---

<section class="seccao chamada">
  <div class="contentor chamada__dentro">
    <div>
      <span class="sobretitulo">Inscrições {site.inscricoes.anoLetivo}</span>
      <h2>Escolhe um curso com futuro.</h2>
      <p>Faz a tua pré-inscrição online. A secretaria entra em contacto para concluir o processo.</p>
    </div>
    <div class="chamada__acoes">
      <a href="/inscricoes/" class="botao botao--primario">Inscreve-te <Icone nome="seta" tamanho={18} /></a>
      <a href="/contactos/" class="botao botao--contorno-claro">Fala connosco</a>
    </div>
  </div>
</section>

<style>
  .chamada {
    background: var(--petroleo-2);
    background-image: radial-gradient(50rem 24rem at 0% 100%, rgb(98 173 66 / 0.22), transparent 60%);
    color: #d5e2de;
  }
  .chamada__dentro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .chamada .sobretitulo {
    color: var(--verde);
  }
  h2 {
    color: #fff;
  }
  p {
    margin: 0;
    max-width: 50ch;
  }
  .chamada__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
